rn validations;\n    }\n    return {\n      user: {\n        ...validations.user,\n        name: {\n          required,\n          minLength: minLength(3)\n        }\n      }\n    };\n  },\n  watch: {\n    ['v$.user.name.$invalid']() {\n      if (this.v$.user.name) {\n        if (!this.v$.user.name.$invalid) {\n          this.isNameValid = true;\n        } else {\n          this.isNameValid = false;\n        }\n      }\n    },\n    ['v$.user.email.$invalid']() {\n      if (!this.v$.user.email.$invalid) {\n        this.isEmailValid = true;\n      } else {\n        this.isEmailValid = false;\n      }\n    },\n    ['v$.user.password.$invalid']() {\n      if (!this.v$.user.password.$invalid) {\n        this.isPasswordValid = true;\n      } else {\n        this.isPasswordValid = false;\n      }\n    }\n  },\n  methods: {\n    async submit() {\n      this.isLoading = true;\n      try {\n        //\n        this.$router.push(this.$route.query.redirect || '/dashboard');\n      } catch (e) {\n        this.error = e.errorMessage;\n        this.showSnackbar = true;\n      } finally {\n        this.error = 'login não implementado';\n        this.showSnackbar = true;\n        setTimeout(() => {\n          this.isLoading = false;\n        }, 5000);\n      }\n    }\n  }\n};","map":{"version":3,"names":["useVuelidate","required","email","minLength","name","setup","v$","data","error","undefined","isLoading","isLogin","showSnackbar","user","password","isNameValid","isEmailValid","isPasswordValid","computed","nameErrors","errors","$dirty","$response","push","$params","min","emailErrors","passwordErrors","validations","watch","v$.user.name.$invalid","$invalid","v$.user.email.$invalid","v$.user.password.$invalid","methods","submit","$router","$route","query","redirect","e","errorMessage","setTimeout"],"sources":["D:\\projetos\\locaweb\\src\\modules\\login\\views\\Login.vue"],"sourcesContent":["<template>\r\n  <v-container>\r\n    <v-row justify=\"center\" align=\"center\" class=\"h-scre