y) {\r\n        return errors\r\n      }\r\n\r\n      !email.required.$response && errors.push('Email é obrigatório!')\r\n      !email.email.$response && errors.push('Insira um email válido!')\r\n\r\n      return errors\r\n    },\r\n    passwordErrors() {\r\n      const  errors = []\r\n      const password = this.v$.user.password\r\n      \r\n      if (!password.$dirty) {\r\n        return errors\r\n      }\r\n\r\n      !password.required.$response && errors.push('Senha é obrigatória!')\r\n      !password.minLength.$response && errors.push(`Insira pelo menos ${password.minLength.$params.min} caracteres!`)\r\n      \r\n      return errors\r\n    }\r\n  },\r\n  validations: function () {\r\n    const validations = {\r\n      user: {\r\n        email: {\r\n          required,\r\n          email\r\n        },\r\n        password: {\r\n          required,\r\n          minLength: minLength(6)\r\n        }\r\n      }\r\n    }\r\n\r\n    if (this.isLogin) {\r\n      this.user.name = ''\r\n      return validations\r\n    }\r\n\r\n    return {\r\n      user: {\r\n        ...validations.user,\r\n        name: {\r\n          required,\r\n          minLength: minLength(3)\r\n        }\r\n      }\r\n    }\r\n  },\r\n  watch: {\r\n    ['v$.user.name.$invalid']() {\r\n     if (this.v$.user.name) {\r\n       if(!this.v$.user.name.$invalid) {\r\n          this.isNameValid = true;\r\n        } else {\r\n          this.isNameValid = false;\r\n        }\r\n     }\r\n     \r\n    },\r\n    ['v$.user.email.$invalid']() {\r\n      if(!this.v$.user.email.$invalid) {\r\n        this.isEmailValid = true;\r\n      } else {\r\n        this.isEmailValid = false;\r\n      }\r\n    },\r\n    ['v$.user.password.$invalid']() {\r\n      if(!this.v$.user.password.$invalid) {\r\n        this.isPasswordValid = true;\r\n      } else {\r\n        this.isPasswordValid = false;\r\n      }\r\n    },\r\n  },\r\n  methods: {\r\n    async submit() {\r\n      this.isLoading = true;\r\n      \r\n      try {\r\n  