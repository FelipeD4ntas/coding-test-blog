{"ast":null,"code":"export default {\n  name: 'FormCadastro',\n  props: {\n    plano: Object\n  }\n};","map":{"version":3,"names":["name","props","plano","Object"],"sources":["D:\\projetos\\locaweb\\src\\modules\\cadastro\\components\\FormularioCadastro.vue"],"sourcesContent":["<template>\r\n  <v-row class=\"mt-9\">\r\n    <v-col cols=\"7\">\r\n      <v-card flat border rounded>\r\n        <v-card-text>\r\n          \r\n          <v-card-title class=\"text--primary titulo-login\">Entre na sua conta</v-card-title>\r\n          <v-card-subtitle class=\"sub-titulo-login\" color=\"text\">Para aceesar sua conta informe seu e-mail e senha</v-card-subtitle>\r\n          \r\n          <v-card-text>\r\n            <v-form>\r\n              <v-label class=\"custom-label-color\" text=\"E-mail\"></v-label>\r\n              <v-text-field \r\n                v-model.trim=\"v$.user.email.$model\" \r\n                variant=\"outlined\" \r\n                name=\"email\" \r\n                placeholder=\"Seu e-mail\"\r\n                type=\"email\"\r\n                :error-messages=\"emailErrors\"\r\n                :color=\"isEmailValid ? 'success' : 'default'\">\r\n              </v-text-field>\r\n\r\n              <v-label class=\"custom-label-color mt-3\" text=\"Senha\"></v-label>\r\n              <v-text-field \r\n                v-model.trim=\"v$.user.password.$model\" \r\n                variant=\"outlined\" \r\n                name=\"password\" \r\n                placeholder=\"Sua senha\"\r\n                type=\"password\"\r\n                :error-messages=\"passwordErrors\"\r\n                :color=\"isPasswordValid ? 'success' : 'default'\"\r\n                class=\"custom-text-field\">\r\n              </v-text-field>\r\n              <v-btn variant=\"plain\" flat class=\"float-right v-btn--no-padding v-btn--text-no-uppercase text-body-1 mt-n6\">Esqueci minha senha</v-btn>\r\n            </v-form>\r\n          </v-card-text>\r\n\r\n          <v-card-text>\r\n            <v-btn block variant=\"text\" class=\"bg-primary pa-10 font-weight-regular text-uppercase text-body-1\">Fazer Login</v-btn>\r\n          </v-card-text>\r\n        </v-card-text>\r\n      </v-card>\r\n    </v-col>\r\n\r\n    <v-col cols=\"3\">\r\n      <v-card flat class=\"text-center pa-9 custom-v-card\">\r\n        <v-btn\r\n         variant=\"flat\"\r\n         rounded=\"lg\"\r\n         v-if=\"plano.maisUsado\"\r\n         class=\"custom-v-btn-plano-escolhido\">\r\n          Plano escolhido\r\n        </v-btn>\r\n\r\n        <v-card-title class=\"custom-title\">Hospedagem {{plano.hospedagem}}</v-card-title>\r\n        <div class=\"my-4\">\r\n          \r\n          <p class=\"text-h4 custom-valor\">\r\n            <span class=\"custom-span-valor\" v-if=\"plano.valor != 'Grátis'\">R$</span>\r\n            {{ plano.valor }}\r\n            <span class=\"custom-span-valor\" v-if=\"plano.valor != 'Grátis'\">/mês</span></p>\r\n        </div>\r\n        <v-card-subtitle>{{ plano.detalheValor }}</v-card-subtitle>\r\n        <v-card-subtitle class=\"my-2\">{{ plano.taxa }}</v-card-subtitle>\r\n\r\n        <v-divider class=\"mb-4 my-4 mx-5\"></v-divider>\r\n\r\n        <div class=\"my-4 mb-4 custom-ideal\">\r\n          <p class=\"text-h6 custom-text-h6 px-9\">Ideal {{ plano.ideal }}</p>\r\n        </div>\r\n\r\n        <v-divider class=\"mb-4 my-4 mx-5\"></v-divider>\r\n\r\n        <v-card-title class=\"text-left mt-5\">\r\n          Seu site em servidores <span class=\"text-underline\">no<br>{{ plano.paisServidor}}</span>\r\n        </v-card-title>\r\n\r\n        <v-list-item>\r\n          <ul class=\"custom-list text-left\">\r\n            <li class=\"custom-list-item\"  v-for=\"(beneficio, index) in plano.beneficios\" :key=\"index\">\r\n              <v-icon icon=\"mdi-check\" class=\"custom-icon\"></v-icon>\r\n              <p class=\"custom-list-item-title\">{{ beneficio }}</p>\r\n            </li>\r\n          </ul>\r\n        </v-list-item>\r\n\r\n        <v-card-title class=\"text-left mt-5\">\r\n          Suporte 24 horas, 7 dias por <br> semana grátis;\r\n        </v-card-title>\r\n\r\n        <v-card-title class=\"text-left mt-5\">\r\n          Aplicativos disponíveis;\r\n        </v-card-title>\r\n\r\n        <v-list-item>\r\n          <ul class=\"custom-list text-left\">\r\n            <li class=\"custom-list-item\"  v-for=\"(aplicativo, index) in plano.aplicativosDisponiveis\" :key=\"index\">\r\n              <v-icon icon=\"mdi-check\" class=\"custom-icon\"></v-icon>\r\n              <p class=\"custom-list-item-title\">{{ aplicativo }}</p>\r\n            </li>\r\n          </ul>\r\n        </v-list-item>\r\n\r\n        <div v-if=\"plano.valor != 'Grátis'\">\r\n          <v-card-title class=\"text-left mt-5\">\r\n            Migração Gratuita;\r\n          </v-card-title>\r\n  \r\n          <v-list-item>\r\n            <ul class=\"custom-list text-left\">\r\n              <li class=\"custom-list-item\">\r\n                <v-icon icon=\"mdi-check\" class=\"custom-icon\"></v-icon>\r\n                <p class=\"custom-list-item-title\">Migramos todos os seus sites <br>para nossos servidores</p>\r\n              </li>\r\n            </ul>\r\n          </v-list-item>\r\n        </div>\r\n\r\n        <v-card-title class=\"text-left mt-5\">\r\n          Você ainda tem;\r\n        </v-card-title>\r\n\r\n        <v-list-item>\r\n          <ul class=\"custom-list text-left\">\r\n            <li class=\"custom-list-item\"  v-for=\"(bonus, index) in plano.voceAindaTem\" :key=\"index\">\r\n              <v-icon icon=\"mdi-check\" class=\"custom-icon\"></v-icon>\r\n              <p class=\"custom-list-item-title\">{{ bonus }}</p>\r\n            </li>\r\n          </ul>\r\n        </v-list-item>\r\n\r\n      </v-card>\r\n    </v-col>\r\n  </v-row>\r\n</template>\r\n\r\n<script>\r\nexport default { \r\n  name: 'FormCadastro',\r\n  props: { plano: Object }\r\n}\r\n</script>\r\n\r\n<style>\r\n.custom-v-btn-plano-escolhido {\r\n  background-color: black !important;\r\n  color: white;\r\n  font-weight: 400;\r\n  position: absolute;\r\n  top: 0;\r\n  left: 50%;\r\n  transform: translate(-50%, -10px);\r\n  z-index: 30 !important;\r\n  cursor: default;\r\n}\r\n</style>"],"mappings":"AAyIA,eAAe;EACbA,IAAI,EAAE,cAAc;EACpBC,KAAK,EAAE;IAAEC,KAAK,EAAEC;EAAO;AACzB"},"metadata":{},"sourceType":"module","externalDependencies":[]}