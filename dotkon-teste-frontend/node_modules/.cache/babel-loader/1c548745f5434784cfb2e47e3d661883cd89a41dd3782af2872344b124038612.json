ta center de São Paulo;', 'ASP, ASP.NET 2.0/3.0/3.5/ e 4.9/4.5/4.5.1/4.5.2(medium trust) ou PHP 5.3, 5.4, 5.5, 5.6 e 7.0;', 'Ilimitado usuários de FTP para upload ou download;', 'Ilimitado contas de e-mails profissionais;', '50 subdominios gratuitos;'],\n        migracao: 'Migramos todos seus sites para nossos servidores;',\n        voceAindaTem: ['Webmail RoundCube;', 'AntiSpam;', 'Painel de gerenciamento de DNS;', 'Painel de controle web;', 'Configurações de PHP personalizáveis;', 'Certificado SSL Grátis;', 'Transferência ilimitada.']\n      }],\n      aplicativosDisponiveis: ['Wordpress;', 'Drupal;', 'entre outros...']\n    };\n  }\n};","map":{"version":3,"names":["name","data","planos","hospedagem","maisUsado","valor","detalheValor","taxa","ideal","paisServidor","beneficios","voceAindaTem","migracao","aplicativosDisponiveis"],"sources":["D:\\projetos\\locaweb\\src\\modules\\cadastro\\components\\PlanoHospedagem.vue"],"sourcesContent":["<template>\r\n  <v-row align-content=\"center\" justify=\"center\" class=\"mt-8\">\r\n    <v-col v-for=\"(plano, index) in planos\" :key=\"index\" cols=\"3\">\r\n      \r\n      <v-card class=\"text-center pa-9\">\r\n        <v-btn\r\n         variant=\"flat\"\r\n         rounded=\"lg\"\r\n         v-if=\"plano.maisUsado\"\r\n         class=\"custom-v-btn-mais-usado\">\r\n          Mais usado\r\n        </v-btn>\r\n\r\n        <v-card-title class=\"custom-title\">Hospedagem {{plano.hospedagem}}</v-card-title>\r\n        <div class=\"my-4\">\r\n          \r\n          <p class=\"text-h4 custom-valor\">\r\n            <span class=\"custom-span-valor\" v-if=\"plano.valor != 'Grátis'\">R$</span>\r\n            {{ plano.valor }}\r\n            <span class=\"custom-span-valor\" v-if=\"plano.valor != 'Grátis'\">/mês</span></p>\r\n        </div>\r\n        <v-card-subtitle>{{ plano.detalheValor }}</v-card-subtitle>\r\n        <v-card-subtitle class=\"my-2\">{{ plano.taxa }}</v-card-subtitle>\r\n\r\n        <v-divider class=\"mb-4 my-4 mx-5\"></v-divider>\r\n\r\n        <div class=\"my-4 mb-4 custom-ideal\">\r\n          <p class=\"text-h6 custom-text-h6 px-9\">Ideal {{ plano.ideal }}</p>\r\n        </div>\r\n\r\n        <v-divider class=\"mb-4 my-4 mx-5\"></v-divider>\r\n\r\n        <v-card-text class=\"mx-9\">\r\n          <v-btn block variant=\"text\" class=\"bg-primary pa-7 font-weight-regular text-uppercase text-body-1\">\r\n            Escolher esse plano\r\n          </v-btn>\r\n        </v-card-text>\r\n\r\n        <v-card-title class=\"text-left mt-5\">\r\n          Seu site em servidores <span class=\"text-underline\">no<br>{{ plano.paisServidor}}</span>\r\n        </v-card-title>\r\n\r\n        <v-list-item class=\"text-left custom-list-item\" v-for=\"(beneficio, index) in plano.beneficios\" :key=\"index\">\r\n          <template v-slot:prepend>\r\n            <v-icon icon=\"mdi-check\" class=\"custom-icon\"></v-icon>\r\n          </template>\r\n          <p class=\"custom-list-item-title\">{{ beneficio }}</p>\r\n        </v-list-item>\r\n\r\n        <v-card-title class=\"text-left mt-5\">\r\n          Suporte 24 horas, 7 dias por <br> semana grátis;\r\n        </v-card-title>\r\n\r\n        <v-card-title class=\"text-left mt-5\">\r\n          Aplicativos disponíveis;\r\n        </v-card-title>\r\n\r\n        <v-list-item class=\"text-left custom-list-item\" v-for=\"(aplicativo, index) in aplicativosDisponiveis\" :key=\"index\">\r\n          <template v-slot:prepend>\r\n            <v-icon icon=\"mdi-check\" class=\"custom-icon\"></v-icon>\r\n          </template>\r\n          <p class=\"custom-list-item-title\">{{ aplicativo }}</p>\r\n        </v-list-item>\r\n\r\n        <div v-if=\"plano.valor != 'Grátis'\">\r\n          <v-card-title class=\"text-left mt-5\">\r\n            Migração Gratuita;\r\n          </v-card-title>\r\n  \r\n          <v-list-item class=\"text-left custom-list-item\">\r\n            <template v-slot:prepend>\r\n              <v-icon icon=\"mdi-check\" class=\"custom-icon\"></v-icon>\r\n            </template>\r\n            <p class=\"custom-list-item-title\">Migramos todos os seus sites <br>para nossos servidores</p>\r\n          </v-list-item>\r\n        </div>\r\n\r\n        <v-card-title class=\"text-left mt-5\">\r\n          Você ainda tem;\r\n        </v-card-title>\r\n\r\n        <v-list-item class=\"text-left custom-list-item\" v-for=\"(bonus, index) in plano.voceAindaTem\" :key=\"index\">\r\n          <template v-slot:prepend>\r\n            <v-icon icon=\"mdi-check\" class=\"custom-icon\"></v-icon>\r\n          </template>\r\n          <p class=\"custom-list-item-title\">{{ bonus }}</p>\r\n        </v-list-item>\r\n\r\n      </v-card>\r\n    </v-col>\r\n  </v-row>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'HospedagemComponent',\r\n  data() {\r\n    return {\r\n      planos: [\r\n        {\r\n          hospedagem: 1,\r\n          maisUsado: false,\r\n          valor: 'Grátis',\r\n          detalheValor: 'você não paga nada para usar',\r\n          taxa: 'sem taxa de setup',\r\n          ideal: 'para quem está começando.',\r\n          paisServidor: 'Estados Unidos.',\r\n          beneficios: [\r\n            'Servidores em nossos data center americanos;',\r\n            'ASP, ASP.NET 2.0/3.0/3.5/ e 4.9/4.5/4.5.1/4.5.2(medium trust) ou PHP 5.3, 5.4, 5.5, 5.6 e 7.0;',\r\n            '1 usuário de FTP para upload ou download;',\r\n            '1 conta de e-mails profissionais;',\r\n            '1 subdominio gratuito;'\r\n          ],\r\n          voceAindaTem: [\r\n            'Webmail RoundCube;',\r\n            'AntiSpam;',\r\n            'Painel de gerenciamento de DNS;',\r\n            'Painel de controle web;',\r\n            'Configurações de PHP personalizáveis;',\r\n            'Certificado SSL Grátis;',\r\n            'Transferência ilimitada.'\r\n          ]\r\n        },\r\n        {\r\n          hospedagem: 2,\r\n          maisUsado: true,\r\n          valor: '499',\r\n          detalheValor: 'cobrado mensalmente',\r\n          taxa: 'sem taxa de setup',\r\n          ideal: 'para site com mais de 30k de visitas.',\r\n          paisServidor: 'Brasil.',\r\n          beneficios: [\r\n            'Servidores em nossos data center de São Paulo;',\r\n            'ASP, ASP.NET 2.0/3.0/3.5/ e 4.9/4.5/4.5.1/4.5.2(medium trust) ou PHP 5.3, 5.4, 5.5, 5.6 e 7.0;',\r\n            '10 usuários de FTP para upload ou download;',\r\n            '30 contas de e-mails profissionais;',\r\n            '10 subdominios gratuitos;'\r\n          ],\r\n          migracao: 'Migramos todos seus sites para nossos servidores;',\r\n          voceAindaTem: [\r\n            'Webmail RoundCube;',\r\n            'AntiSpam;',\r\n            'Painel de gerenciamento de DNS;',\r\n            'Painel de controle web;',\r\n            'Configurações de PHP personalizáveis;',\r\n            'Certificado SSL Grátis;',\r\n            'Transferência ilimitada.'\r\n          ]\r\n        },\r\n        {\r\n          hospedagem: 3,\r\n          maisUsado: false,\r\n          valor: '999',\r\n          detalheValor: 'cobrado mensalmente',\r\n          taxa: 'sem taxa de setup',\r\n          ideal: 'para site com mais de 60k de visitas.',\r\n          paisServidor: 'Brasil.',\r\n          beneficios: [\r\n            'Servidores em nossos data center de São Paulo;',\r\n            'ASP, ASP.NET 2.0/3.0/3.5/ e 4.9/4.5/4.5.1/4.5.2(medium trust) ou PHP 5.3, 5.4, 5.5, 5.6 e 7.0;',\r\n            'Ilimitado usuários de FTP para upload ou download;',\r\n            'Ilimitado contas de e-mails profissionais;',\r\n            '50 subdominios gratuitos;'\r\n          ],\r\n          migracao: 'Migramos todos seus sites para nossos servidores;',\r\n          voceAindaTem: [\r\n            'Webmail RoundCube;',\r\n            'AntiSpam;',\r\n            'Painel de gerenciamento de DNS;',\r\n            'Painel de controle web;',\r\n            'Configurações de PHP personalizáveis;',\r\n            'Certificado SSL Grátis;',\r\n            'Transferência ilimitada.'\r\n          ]\r\n        }\r\n      ],\r\n      aplicativosDisponiveis: [\r\n        'Wordpress;',\r\n        'Drupal;',\r\n        'entre outros...'\r\n      ]\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style>\r\n.custom-title {\r\n  color: #646465;\r\n  font-size: 28px;\r\n}\r\n\r\n.custom-valor {\r\n  color: #F30168;\r\n  font-weight: bold;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n\r\n.custom-span-valor {\r\n  font-weight: normal;\r\n  font-size: 20px;\r\n}\r\n\r\n.custom-ideal {\r\n  padding: 0 25px;\r\n}\r\n\r\n.custom-text-h6 {\r\n  color: #646465 !important;\r\n  font-weight: 400 !important;\r\n}\r\n\r\n.text-underline {\r\n  text-decoration: underline;\r\n  text-decoration-thickness: 1px;\r\n}\r\n\r\n.custom-list-item .v-icon.custom-icon {\r\n  margin-right: 8px;\r\n}\r\n.custom-v-btn-mais-usado {\r\n  background-color: #10C203 !important;\r\n  color: white;\r\n  font-weight: 400;\r\n  position: absolute;\r\n  top: 0;\r\n  left: 50%;\r\n  transform: translate(-50%, -10px);\r\n  z-index: 2;\r\n}\r\n</style>"],"mappings":"AA8FA,eAAe;EACbA,IAAI,EAAE,qBAAqB;EAC3BC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,MAAM,EAAE,CACN;QACEC,UAAU,EAAE,CAAC;QACbC,SAAS,EAAE,KAAK;QAChBC,KAAK,EAAE,QAAQ;QACfC,YAAY,EAAE,8BAA8B;QAC5CC,IAAI,EAAE,mBAAmB;QACzBC,KAAK,EAAE,2BAA2B;QAClCC,YAAY,EAAE,iBAAiB;QAC/BC,UAAU,EAAE,CACV,8CAA8C,EAC9C,gGAAgG,EAChG,2CAA2C,EAC3C,mCAAmC,EACnC,wBAAuB,CACxB;QACDC,YAAY,EAAE,CACZ,oBAAoB,EACpB,WAAW,EACX,iCAAiC,EACjC,yBAAyB,EACzB,uCAAuC,EACvC,yBAAyB,EACzB,0BAAyB;MAE7B,CAAC,EACD;QACER,UAAU,EAAE,CAAC;QACbC,SAAS,EAAE,IAAI;QACfC,KAAK,EAAE,KAAK;QACZC,YAAY,EAAE,qBAAqB;QACnCC,IAAI,EAAE,mBAAmB;QACzBC,KAAK,EAAE,uCAAuC;QAC9CC,YAAY,EAAE,SAAS;QACvBC,UAAU,EAAE,CACV,gDAAgD,EAChD,gGAAgG,EAChG,6CAA6C,EAC7C,qCAAqC,EACrC,2BAA0B,CAC3B;QACDE,QAAQ,EAAE,mDAAmD;QAC7DD,YAAY,EAAE,CACZ,oBAAoB,EACpB,WAAW,EACX,iCAAiC,EACjC,yBAAyB,EACzB,uCAAuC,EACvC,yBAAyB,EACzB,0BAAyB;MAE7B,CAAC,EACD;QACER,UAAU,