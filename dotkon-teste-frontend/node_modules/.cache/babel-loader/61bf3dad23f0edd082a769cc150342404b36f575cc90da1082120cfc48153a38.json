ser.senha,\r\n          confirmacaoSenha: this.user.confirmacaoSenha\r\n      }\r\n\r\n      try {\r\n        const response = await servicesUser.adicionar('usuario', bodyUser);\r\n        this.$router.push(this.$route.query.redirect || '/login');\r\n        console.log(response);\r\n        this.isLoading = false;\r\n      } catch(e) {\r\n        this.isLoading = false;\r\n\r\n        window.alert('Usuário ou senha inválidos');\r\n\r\n        console.log(e);\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.custom-bg {\r\n  background-color: gray;\r\n  color: white;\r\n}\r\n\r\n.titulo-login {\r\n  white-space: wrap;\r\n}\r\n\r\nspan {\r\n  color: #F30168;\r\n  text-decoration: underline;\r\n  text-decoration-thickness: 1px;\r\n  cursor: default;\r\n}\r\n\r\n.custom-subtitle {\r\n  color: black !important;\r\n  font-weight: 600;\r\n}\r\n</style>"],"mappings":";AAwDA,SAASA,YAAW,QAAS,6BAA4B;AAEzD,eAAe;EACbC,IAAI,EAAE,cAAc;EACpBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE;QACJC,IAAI,EAAE,EAAE;QACRC,KAAK,EAAE,EAAE;QACTC,KAAK,EAAE,EAAE;QACTC,gBAAgB,EAAE;MACpB;IACF;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,MAAMA,CAAA,EAAG;MACP,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,IAAI,CAACC,MAAM,CAACC,KAAK,CAACC,QAAO,IAAK,QAAQ,CAAC;IAC3D,CAAC;IACD,MAAMC,MAAMA,CAAA,EAAG;MACb,IAAI,CAACC,SAAQ,GAAI,IAAI;MAErB,MAAMC,QAAO,GAAK;QACdb,IAAI,EAAE,IAAI,CAACD,IAAI,CAACC,IAAI;QACpBC,KAAK,EAAE,IAAI,CAACF,IAAI,CAACE,KAAK;QACtBC,KAAK,EAAE,IAAI,CAACH,IAAI,CAACG,KAAK;QACtBC,gBAAgB,EAAE,IAAI,CAACJ,IAAI,CAACI;MAChC;MAEA,IAAI;QACF,MAAMW,QAAO,GAAI,MAAMlB,YAAY,CAACmB,SAAS,CAAC,SAAS,EAAEF,QAAQ,CAAC;QAClE,IAAI,CAACP,OAAO,CAACC,IAAI,CAAC,IAAI,CAACC,MAAM,CAACC,KAAK,CAACC,QAAO,IAAK,QAAQ,CAAC;QACzDM,OAAO,CAACC,GAAG,CAACH,QAAQ,CAAC;QACrB,IAAI,CAACF,SAAQ,GAAI,KAAK;MACxB,EAAE,OAAMM,CAAC,EAAE;QACT,IAAI,CAACN,SAAQ,GAAI,KAAK;QAEtBO,MAAM,CAACC,KAAK,CAAC,4BAA4B,CAAC;QAE1CJ,OAAO,CAACC,GAAG,CAACC,CAAC,CAAC;MAChB;IACF;EACF;AACF"},"metadata":{},"sourceType":"module","externalDependencies":[]}