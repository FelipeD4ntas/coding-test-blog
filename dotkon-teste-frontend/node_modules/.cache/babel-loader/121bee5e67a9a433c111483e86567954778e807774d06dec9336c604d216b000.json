{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { useVuelidate } from '@vuelidate/core';\nimport { required, email, minLength } from '@vuelidate/validators';\nexport default {\n  name: 'LoginView',\n  setup() {\n    return {\n      v$: useVuelidate()\n    };\n  },\n  data() {\n    return {\n      error: undefined,\n      isLoading: false,\n      showSnackbar: false,\n      user: {\n        email: '',\n        password: ''\n      }\n    };\n  },\n  computed: {\n    nameErrors() {\n      const errors = [];\n      const name = this.v$.user.name;\n      if (!name.$dirty) {\n        return errors;\n      }\n      !name.required.$response && errors.push('Nome é obrigatório!');\n      !name.minLength.$response && errors.push(`Insira pelo menos ${name.minLength.$params.min} caracteres!`);\n      return errors;\n    },\n    emailErrors() {\n      const errors = [];\n      const email = this.v$.user.email;\n      if (!email.$dirty) {\n        return errors;\n      }\n      !email.required.$response && errors.push('Email é obrigatório!');\n      !email.email.$response && errors.push('Insira um email válido!');\n      return errors;\n    },\n    passwordErrors() {\n      const errors = [];\n      const password = this.v$.user.password;\n      if (!password.$dirty) {\n        return errors;\n      }\n      !password.required.$response && errors.push('Senha é obrigatória!');\n      !password.minLength.$response && errors.push(`Insira pelo menos ${password.minLength.$params.min} caracteres!`);\n      return errors;\n    }\n  },\n  validations: function () {\n    const validations = {\n      user: {\n        email: {\n          required,\n          email\n        },\n        password: {\n          required,\n          minLength: minLength(6)\n        }\n      }\n    };\n    if (this.isLogin) {\n      this.user.name = '';\n      return validations;\n    }\n    return {\n      user: {\n        ...validations.user,\n        name: {\n          required,\n          minLength: minLength(3)\n        }\n      }\n    };\n  },\n  methods: {\n    async submit() {\n      this.isLoading = true;\n      try {\n        //\n        this.$router.push(this.$route.query.redirect || '/dashboard');\n      } catch (e) {\n        this.error = e.errorMessage;\n        this.showSnackbar = true;\n      } finally {\n        this.error = 'login não implementado';\n        this.showSnackbar = true;\n        setTimeout(() => {\n          this.isLoading = false;\n        }, 5000);\n      }\n    },\n    registerUser() {\n      this.$router.push('/cadastro');\n    }\n  }\n};","map":{"version":3,"names":["useVuelidate","required","email","minLength","name","setup","v$","data","error","undefined","isLoading","showSnackbar","user","password","computed","nameErrors","errors","$dirty","$response","push","$params","min","emailErrors","passwordErrors","validations","isLogin","methods","submit","$router","$route","query","redirect","e","errorMessage","setTimeout","registerUser"],"sources":["D:\\projetos\\locaweb\\src\\modules\\login\\views\\Login.vue"],"sourcesContent":["<template>\r\n  <v-row justify=\"center\" align=\"center\" class=\"h-screen\">\r\n    <v-col cols=\"4\">\r\n      <v-card variant=\"text\" class=\"mb-10\">\r\n        <v-img src=\"@/assets/logo.png\" :width=\"200\" class=\"custom-v-img\"></v-img>\r\n      </v-card>\r\n\r\n      <v-card flat border rounded>\r\n        <v-card-text>\r\n          \r\n          <v-card-title class=\"text--primary titulo-login\">Entre na sua conta</v-card-title>\r\n          <v-card-subtitle class=\"sub-titulo-login\" color=\"text\">Para aceesar sua conta informe seu e-mail e senha</v-card-subtitle>\r\n          \r\n          <v-card-text>\r\n            <v-form>\r\n              <v-label class=\"custom-label-color\" text=\"E-mail\"></v-label>\r\n              <v-text-field \r\n                v-model.trim=\"v$.user.email.$model\" \r\n                variant=\"outlined\" \r\n                name=\"email\" \r\n                placeholder=\"Seu e-mail\"\r\n                type=\"email\"\r\n                :error-messages=\"emailErrors\"\r\n                :color=\"isEmailValid ? 'success' : 'default'\">\r\n              </v-text-field>\r\n\r\n              <v-label class=\"custom-label-color mt-3\" text=\"Senha\"></v-label>\r\n              <v-text-field \r\n                v-model.trim=\"v$.user.password.$model\" \r\n                variant=\"outlined\" \r\n                name=\"password\" \r\n                placeholder=\"Sua senha\"\r\n                type=\"password\"\r\n                :error-messages=\"passwordErrors\"\r\n                :color=\"isPasswordValid ? 'success' : 'default'\"\r\n                class=\"custom-text-field\">\r\n              </v-text-field>\r\n              <v-btn variant=\"plain\" flat class=\"float-right v-btn--no-padding v-btn--text-no-uppercase text-body-1 mt-n6\">Esqueci minha senha</v-btn>\r\n            </v-form>\r\n          </v-card-text>\r\n\r\n          <v-card-text>\r\n            <v-btn block variant=\"text\" class=\"bg-primary pa-10 font-weight-regular text-uppercase text-body-1\">Fazer Login</v-btn>\r\n          </v-card-text>\r\n        </v-card-text>\r\n\r\n        <!-- <v-snackbar\r\n          location=\"top\"\r\n          v-model=\"showSnackbar\">\r\n          {{ error }}\r\n          <template v-slot:actions>\r\n            <v-btn color=\"pink\"  variant=\"text\" @click=\"showSnackbar = false\">\r\n              <v-icon icon=\"mdi-close-thick\"></v-icon>\r\n            </v-btn>\r\n          </template>\r\n        </v-snackbar> -->\r\n\r\n      </v-card>\r\n\r\n      <div class=\"box-link-criar-conta\">\r\n        <p>Ainda não tem conta? \r\n          <span @click=\"registerUser\">Cadastre-se</span>\r\n        </p>\r\n      </div>\r\n    </v-col>\r\n  </v-row>\r\n</template>\r\n\r\n<script>\r\nimport { useVuelidate } from '@vuelidate/core'\r\nimport { required, email, minLength } from '@vuelidate/validators'\r\n\r\nexport default {\r\n  name: 'LoginView',\r\n  setup() {\r\n    return { v$: useVuelidate() }\r\n  },\r\n  data() {\r\n    return {\r\n      error: undefined,\r\n      isLoading: false,\r\n      showSnackbar: false,\r\n      user: {\r\n        email: '',\r\n        password: ''\r\n      }\r\n    }\r\n  },\r\n  computed: {\r\n    nameErrors() {\r\n      const  errors = []\r\n      const name = this.v$.user.name\r\n      \r\n      if (!name.$dirty) {\r\n        return errors\r\n      }\r\n\r\n      !name.required.$response && errors.push('Nome é obrigatório!')\r\n      !name.minLength.$response && errors.push(`Insira pelo menos ${name.minLength.$params.min} caracteres!`)\r\n      \r\n      return errors\r\n    },\r\n    emailErrors() {\r\n      const  errors = []\r\n      const email = this.v$.user.email\r\n      \r\n      if (!email.$dirty) {\r\n        return errors\r\n      }\r\n\r\n      !email.required.$response && errors.push('Email é obrigatório!')\r\n      !email.email.$response && errors.push('Insira um email válido!')\r\n\r\n      return errors\r\n    },\r\n    passwordErrors() {\r\n      const  errors = []\r\n      const password = this.v$.user.password\r\n      \r\n      if (!password.$dirty) {\r\n        return errors\r\n      }\r\n\r\n      !password.required.$response && errors.push('Senha é obrigatória!')\r\n      !password.minLength.$response && errors.push(`Insira pelo menos ${password.minLength.$params.min} caracteres!`)\r\n      \r\n      return errors\r\n    }\r\n  },\r\n  validations: function () {\r\n    const validations = {\r\n      user: {\r\n        email: {\r\n          required,\r\n          email\r\n        },\r\n        password: {\r\n          required,\r\n          minLength: minLength(6)\r\n        }\r\n      }\r\n    }\r\n\r\n    if (this.isLogin) {\r\n      this.user.name = ''\r\n      return validations\r\n    }\r\n\r\n    return {\r\n      user: {\r\n        ...validations.user,\r\n        name: {\r\n          required,\r\n          minLength: minLength(3)\r\n        }\r\n      }\r\n    }\r\n  },\r\n  methods: {\r\n    async submit() {\r\n      this.isLoading = true;\r\n      \r\n      try {\r\n        //\r\n        this.$router.push(this.$route.query.redirect || '/dashboard')\r\n      } catch(e) {\r\n        this.error = e.errorMessage\r\n        this.showSnackbar = true\r\n      } finally {\r\n        this.error = 'login não implementado'\r\n        this.showSnackbar = true\r\n\r\n        setTimeout(() => {\r\n          this.isLoading = false;\r\n        }, 5000)\r\n      }\r\n    },\r\n    registerUser() {\r\n      this.$router.push('/cadastro')\r\n    }\r\n  },\r\n}\r\n</script>\r\n\r\n<style>\r\n.titulo-login {\r\n  font-size: 29px;\r\n  font-weight: 900;\r\n}\r\n\r\n.card-padding {\r\n  padding: 50px;\r\n}\r\n\r\n.sub-titulo-login {\r\n  font-size: 19px;\r\n  font-weight: 500;\r\n  color: black !important;\r\n}\r\n\r\n.custom-label-color {\r\n  color: black !important;\r\n  font-weight: 500;\r\n}\r\n\r\n.v-btn--no-padding {\r\n  padding: 0 !important;\r\n}\r\n\r\n.v-btn--text-no-uppercase .v-btn__content {\r\n  text-transform: none !important;\r\n}\r\n\r\n.custom-text-field .v-field__input {\r\n  height: 70px !important; /* Ajuste o valor da altura conforme necessário */\r\n}\r\n\r\n.v-responsive.v-img.custom-v-img {\r\n  margin: 0 auto;\r\n}\r\n\r\n.box-link-criar-conta {\r\n  display: flex;\r\n  justify-content: center;\r\n  margin-top: 36px;\r\n}\r\n\r\n.box-link-criar-conta p {\r\n  font-weight: 400;\r\n  font-size: 20px;\r\n}\r\n\r\n.box-link-criar-conta span {\r\n  color: #F30168;\r\n  text-decoration: underline;\r\n  text-decoration-thickness: 1px;\r\n  cursor: pointer;\r\n}\r\n</style>"],"mappings":";AAqEA,SAASA,YAAW,QAAS,iBAAgB;AAC7C,SAASC,QAAQ,EAAEC,KAAK,EAAEC,SAAQ,QAAS,uBAAsB;AAEjE,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,KAAKA,CAAA,EAAG;IACN,OAAO;MAAEC,EAAE,EAAEN,YAAY,CAAC;IAAE;EAC9B,CAAC;EACDO,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAEC,SAAS;MAChBC,SAAS,EAAE,KAAK;MAChBC,YAAY,EAAE,KAAK;MACnBC