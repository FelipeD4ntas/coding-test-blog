{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: 'CadastroView',\n  data() {\n    return {\n      user: {\n        nome: '',\n        email: '',\n        senha: '',\n        confirmacaoSenha: ''\n      }\n    };\n  },\n  methods: {\n    voltar() {\n      this.$router.push(this.$route.query.redirect || '/login');\n    },\n    async submit() {\n      this.isLoading = true;\n      const bodyUser = {\n        email: this.user.email,\n        senha: this.user.senha\n      };\n      try {\n        const response = await serviceLogin.login('login', bodyUser);\n        this.$router.push(this.$route.query.redirect || '/dashboard');\n        localStorage.setItem('AUTH_TOKEN', response.data.token);\n        this.isLoading = false;\n      } catch (e) {\n        this.isLoading = false;\n        window.alert('Usuário ou senha inválidos');\n        console.log(e);\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","data","user","nome","email","senha","confirmacaoSenha","methods","voltar","$router","push","$route","query","redirect","submit","isLoading","bodyUser","response","serviceLogin","login","localStorage","setItem","token","e","window","alert","console","log"],"sources":["D:\\ESTUDOS\\projetos\\locaweb\\src\\modules\\cadastro\\views\\Cadastro.vue"],"sourcesContent":["<template>\r\n  <v-container>\r\n    <v-card variant=\"text\" class=\"ma-10 custom-ma d-flex justify-center align-center\" color=\"red\" flat>\r\n      <h1>BLOG Simples</h1>\r\n    </v-card>\r\n    \r\n    <v-form>\r\n      <v-label class=\"custom-label-color\" text=\"Nome\"></v-label>\r\n      <v-text-field \r\n        v-model.trim=\"user.nome\" \r\n        variant=\"outlined\" \r\n        name=\"nome\" \r\n        placeholder=\"Seu nome\"\r\n        type=\"nome\">\r\n      </v-text-field>\r\n\r\n      <v-label class=\"custom-label-color\" text=\"E-mail\"></v-label>\r\n      <v-text-field \r\n        v-model.trim=\"user.email\" \r\n        variant=\"outlined\" \r\n        name=\"email\" \r\n        placeholder=\"Seu e-mail\"\r\n        type=\"email\">\r\n      </v-text-field>\r\n\r\n      <v-label class=\"custom-label-color\" text=\"Senha\"></v-label>\r\n      <v-text-field \r\n        v-model.trim=\"user.senha\" \r\n        variant=\"outlined\" \r\n        name=\"senha\" \r\n        placeholder=\"Sua senha\"\r\n        type=\"senha\">\r\n      </v-text-field>\r\n\r\n      <v-label class=\"custom-label-color\" text=\"Confirmação Senha\"></v-label>\r\n      <v-text-field \r\n        v-model.trim=\"user.confirmacaoSenha\" \r\n        variant=\"outlined\" \r\n        name=\"confirmacaoSenha\" \r\n        placeholder=\"Corfirme sua senha\"\r\n        type=\"confirmacaoSenha\">\r\n      </v-text-field>\r\n\r\n      <v-container class=\"d-flex justify-center\">\r\n        <v-card-text>\r\n          <v-btn block variant=\"text\" class=\"custom-bg pa-10 custom-pa font-weight-regular text-uppercase text-body-1\"  @click=\"voltar\">Voltar</v-btn>\r\n        </v-card-text>\r\n        <v-card-text>\r\n          <v-btn block variant=\"text\" class=\"bg-primary pa-10 custom-pa font-weight-regular text-uppercase text-body-1\" @click=\"submit\">Cadastrar</v-btn>\r\n        </v-card-text>\r\n      </v-container>\r\n    </v-form>\r\n  </v-container>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'CadastroView',\r\n  data() {\r\n    return {\r\n      user: {\r\n        nome: '',\r\n        email: '',\r\n        senha: '',\r\n        confirmacaoSenha: ''\r\n      }\r\n    }\r\n  },\r\n  methods: {\r\n    voltar() {\r\n      this.$router.push(this.$route.query.redirect || '/login');\r\n    },\r\n    async submit() {\r\n      this.isLoading = true;\r\n\r\n      const bodyUser =  {\r\n          email: this.user.email,\r\n          senha: this.user.senha\r\n      }\r\n\r\n      try {\r\n        const response = await serviceLogin.login('login', bodyUser);\r\n        this.$router.push(this.$route.query.redirect || '/dashboard');\r\n        localStorage.setItem('AUTH_TOKEN', response.data.token);\r\n        this.isLoading = false;\r\n      } catch(e) {\r\n        this.isLoading = false;\r\n\r\n        window.alert('Usuário ou senha inválidos');\r\n\r\n        console.log(e);\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.custom-bg {\r\n  background-color: gray;\r\n  color: white;\r\n}\r\n\r\n.titulo-login {\r\n  white-space: wrap;\r\n}\r\n\r\nspan {\r\n  color: #F30168;\r\n  text-decoration: underline;\r\n  text-decoration-thickness: 1px;\r\n  cursor: default;\r\n}\r\n\r\n.custom-subtitle {\r\n  color: black !important;\r\n  font-weight: 600;\r\n}\r\n</style>"],"mappings":";AAwDA,eAAe;EACbA,IAAI,EAAE,cAAc;EACpBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE;QACJC,IAAI,EAAE,EAAE;QACRC,KAAK,EAAE,EAAE;QACTC,KAAK,EAAE,EAAE;QACTC,gBAAgB,EAAE;MACpB;IACF;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,MAAMA,CAAA,EAAG;MACP,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,IAAI,CAACC,MAAM,CAACC,KAAK,CAACC,QAAO,IAAK,QAAQ,CAAC;IAC3D,CAAC;IACD,MAAMC,MAAMA,CAAA,EAAG;MACb,IAAI,CAACC,SAAQ,GAAI,IAAI;MAErB,MAAMC,QAAO,GAAK;QACdZ,KAAK,EAAE,IAAI,CAACF,IAAI,CAACE,KAAK;QACtBC,KAAK,EAAE,IAAI,CAACH,IAAI,CAACG;MACrB;MAEA,IAAI;QACF,MAAMY,QAAO,GAAI,MAAMC,YAAY,CAACC,KAAK,CAAC,OAAO,EAAEH,QAAQ,CAAC;QAC5D,IAAI,CAACP,OAAO,CAACC,IAAI,CAAC,IAAI,CAACC,MAAM,CAACC,KAAK,CAACC,QAAO,IAAK,YAAY,CAAC;QAC7DO,YAAY,CAACC,OAAO,CAAC,YAAY,EAAEJ,QAAQ,CAAChB,IAAI,CAACqB,KAAK,CAAC;QACvD,IAAI,CAACP,SAAQ,GAAI,KAAK;MACxB,EAAE,OAAMQ,CAAC,EAAE;QACT,IAAI,CAACR,SAAQ,GAAI,KAAK;QAEtBS,MAAM,CAACC,KAAK,CAAC,4BAA4B,CAAC;QAE1CC,OAAO,CAACC,GAAG,CAACJ,CAAC,CAAC;MAChB;IACF;EACF;AACF"},"metadata":{},"sourceType":"module","externalDependencies":[]}