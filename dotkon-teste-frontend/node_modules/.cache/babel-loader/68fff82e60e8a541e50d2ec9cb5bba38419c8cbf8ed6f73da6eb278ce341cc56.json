{\n          required,\n          minLength: minLength(3)\n        }\n      }\n    };\n  },\n  methods: {\n    async submit() {\n      const bodyUser = {\n        username: this.user.email,\n        password: this.user.password\n      };\n      try {\n        const response = await serviceLogin.login('users', bodyUser);\n        //this.$router.push(this.$route.query.redirect || '/dashboard');\n        //localStorage.setItem('AUTH_TOKEN', response.config.xsrfCookieName);\n      } catch (e) {\n        console.log(e);\n      }\n    },\n    registerUser() {\n      this.$router.push('/cadastro');\n    }\n  }\n};","map":{"version":3,"names":["useVuelidate","required","email","minLength","serviceLogin","name","setup","v$","data","error","undefined","isLoading","user","password","computed","nameErrors","errors","$dirty","$response","push","$params","min","emailErrors","passwordErrors","validations","isLogin","methods","submit","bodyUser","username","response","login","e","console","log","registerUser","$router"],"sources":["D:\\projetos\\locaweb\\src\\modules\\login\\views\\Login.vue"],"sourcesContent":["<template>\r\n  <v-row justify=\"center\" align=\"center\" class=\"h-screen\">\r\n    <v-col cols=\"4\">\r\n      <v-card variant=\"text\" class=\"mb-10\">\r\n        <v-img src=\"@/assets/logo.png\" :width=\"200\" class=\"custom-v-img\"></v-img>\r\n      </v-card>\r\n\r\n      <v-card flat border rounded>\r\n        <v-card-text>\r\n          \r\n          <v-card-title class=\"text--primary titulo-login\">Entre na sua conta</v-card-title>\r\n          <v-card-subtitle class=\"sub-titulo-login\" color=\"text\">Para aceesar sua conta informe seu e-mail e senha</v-card-subtitle>\r\n          \r\n          <v-card-text>\r\n            <v-form>\r\n              <v-label class=\"custom-label-color\" text=\"E-mail\"></v-label>\r\n              <v-text-field \r\n                v-model.trim=\"v$.user.email.$model\" \r\n                variant=\"outlined\" \r\n                name=\"email\" \r\n                placeholder=\"Seu e-mail\"\r\n                type=\"email\"\r\n                :error-messages=\"emailErrors\"\r\n                :color=\"isEmailValid ? 'success' : 'default'\">\r\n              </v-text-field>\r\n\r\n              <v-label class=\"custom-label-color mt-3\" text=\"Senha\"></v-label>\r\n              <v-text-field \r\n                v-model.trim=\"v$.user.password.$model\" \r\n                variant=\"outlined\" \r\n                name=\"password\" \r\n                placeholder=\"Sua senha\"\r\n                type=\"password\"\r\n                :error-messages=\"passwordErrors\"\r\n                :color=\"isPasswordValid ? 'success' : 'default'\"\r\n                class=\"custom-text-field\">\r\n              </v-text-field>\r\n              <v-btn variant=\"plain\" flat class=\"float-right v-btn--no-padding v-btn--text-no-uppercase text-body-1 mt-n6\">Esqueci minha senha</v-btn>\r\n            </v-form>\r\n          </v-card-text>\r\n\r\n          <v-card-text>\r\n            <v-btn block variant=\"text\" class=\"bg-primary pa-10 font-weight-regular text-uppercase text-body-1\" :disabled=\"v$.$invalid\" @click=\"submit\">Fazer Login</v-btn>\r\n          </v-card-text>\r\n        </v-card-text>\r\n      </v-card>\r\n\r\n      <div class=\"box-link-criar-conta\">\r\n        <p>Ainda não tem conta? \r\n          <span @click=\"registerUser\">Cadastre-se</span>\r\n        </p>\r\n      </div>\r\n    </v-col>\r\n  </v-row>\r\n</template>\r\n\r\n<script>\r\nimport { useVuelidate } from '@vuelidate/core'\r\nimport { required, email, minLength } from '@vuelidate/validators'\r\nimport { serviceLogin } from '@/modules/login/services'\r\nexport default {\r\n  name: 'LoginView',\r\n  setup() {\r\n    return { v$: useVuelidate() }\r\n  },\r\n  data() {\r\n    return {\r\n      error: undefined,\r\n      isLoading: false,\r\n      user: {\r\n        email: '',\r\n        password: ''\r\n      }\r\n    }\r\n  },\r\n  computed: {\r\n    nameErrors() {\r\n      const  errors = []\r\n      const name = this.v$.user.name\r\n      \r\n      if (!name.$dirty) {\r\n        return errors\r\n      }\r\n\r\n      !name.required.$response && errors.push('Nome é obrigatório!')\r\n      !name.minLength.$response && errors.push(`Insira pelo menos ${name.minLength.$params.min} caracteres!`)\r\n      \r\n      return errors\r\n    },\r\n    emailErrors() {\r\n      const  errors = []\r\n      const email = this.v$.user.email\r\n      \r\n      if (!email.$dirty) {\r\n        return errors\r\n      }\r\n\r\n      !email.required.$response && errors.push('Email é obrigatório!')\r\n      !email.email.$response && errors.push('Insira um email válido!')\r\n\r\n      return errors\r\n    },\r\n    passwordErrors() {\r\n      const  errors = []\r\n      const password = this.v$.user.password\r\n      \r\n      if (!password.$dirty) {\r\n        return errors\r\n      }\r\n\r\n      !password.required.$response && errors.push('Senha é obrigatória!')\r\n      !password.minLength.$response && errors.push(`Insira pelo menos ${password.minLength.$params.min} caracteres!`)\r\n      \r\n      return errors\r\n    }\r\n  },\r\n  validations: function () {\r\n    const validations = {\r\n      user: {\r\n        email: {\r\n          required,\r\n          email\r\n        },\r\n        password: {\r\n          required,\r\n          minLength: minLength(6)\r\n        }\r\n      }\r\n    }\r\n\r\n    if (this.isLogin) {\r\n      this.user.name = ''\r\n      return validations\r\n    }\r\n\r\n    return {\r\n      user: {\r\n        ...validations.user,\r\n        name: {\r\n          required,\r\n          minLength: minLength(3)\r\n        }\r\n      }\r\n    }\r\n  },\r\n  methods: {\r\n    async submit() {\r\n      const bodyUser =  {\r\n          username: this.user.email,\r\n          password: this.user.password\r\n      }\r\n\r\n      try {\r\n        const response = await serviceLogin.login('users', bodyUser);\r\n        //this.$router.push(this.$route.query.redirect || '/dashboard');\r\n        //localStorage.setItem('AUTH_TOKEN', response.config.xsrfCookieName);\r\n      } catch(e) {\r\n        console.log(e);\r\n      }\r\n    },\r\n    registerUser() {\r\n      this.$router.push('/cadastro')\r\n    }\r\n  },\r\n}\r\n</script>\r\n\r\n<style>\r\n.titulo-login {\r\n  font-size: 29px;\r\n  font-weight: 900;\r\n}\r\n\r\n.card-padding {\r\n  padding: 50px;\r\n}\r\n\r\n.sub-titulo-login {\r\n  font-size: 19px;\r\n  font-weight: 500;\r\n  color: black !important;\r\n}\r\n\r\n.custom-label-color {\r\n  color: black !important;\r\n  font-weight: 500;\r\n}\r\n\r\n.v-btn--no-padding {\r\n  padding: 0 !important;\r\n}\r\n\r\n.v-btn--text-no-uppercase .v-btn__content {\r\n  text-transform: none !important;\r\n}\r\n\r\n.custom-text-field .v-field__input {\r\n  height: 70px !important; /* Ajuste o valor da altura conforme necessário */\r\n}\r\n\r\n.v-responsive.v-img.custom-v-img {\r\n  margin: 0 auto;\r\n}\r\n\r\n.box-link-criar-conta {\r\n  display: flex;\r\n  justify-content: center;\r\n  margin-top: 36px;\r\n}\r\n\r\n.box-link-criar-conta p {\r\n  font-weight: 400;\r\n  font-size: 20px;\r\n}\r\n\r\n.box-link-criar-conta span {\r\n  color: #F30168;\r\n  text-decoration: underline;\r\n  text-decoration-thickness: 1px;\r\n  cursor: pointer;\r\n}\r\n</style>"],"mappings":";AAyDA,SAASA,YAAW,QAAS,iBAAgB;AAC7C,SAASC,QAAQ,EAAEC,KAAK,EAAEC,SAAQ,QAAS,uBAAsB;AACjE,SAASC,YAAW,QAAS,0BAAyB;AACtD,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,KAAKA,CAAA,EAAG;IACN,OAAO;MAAEC,EAAE,EAAEP,YAAY,CAAC;IAAE;EAC9B,CAAC;EACDQ,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAEC,SAAS;MAChBC,SAAS,EAAE,KAAK;MAChBC,IAAI,EAAE;QACJV,KAAK,EAAE,EAAE;QACTW,QAAQ,EAAE;MACZ;IACF;EACF,CAAC;EACDC,QAAQ,EAAE;IACRC,UAAUA,CAAA,EAAG;MACX,MAAOC,MAAK,GAAI,EAAC;MACjB,MAAMX,IAAG,GAAI,IAAI,CAACE,EAAE,CAACK,IAAI,CAACP,IAAG;MAE7B,IAAI,CAACA,IAAI,CAACY,MAAM,EAAE;QAChB,OAAOD,MAAK;MACd;MAEA,CAACX,IAAI,CAACJ,QAAQ,CAACiB,SAAQ,IAAKF,MAAM,CAACG,IAAI,CAAC,