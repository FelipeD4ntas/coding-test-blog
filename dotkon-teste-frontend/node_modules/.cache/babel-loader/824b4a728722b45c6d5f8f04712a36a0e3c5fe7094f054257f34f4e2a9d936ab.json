{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { mask } from 'ke-the-mask';\nimport { useVuelidate } from '@vuelidate/core';\nimport { required, email, minLength } from '@vuelidate/validators';\nexport default {\n  name: 'FormCadastro',\n  setup() {\n    return {\n      v$: useVuelidate()\n    };\n  },\n  props: {\n    plano: Object\n  },\n  directives: {\n    mask\n  },\n  data() {\n    return {\n      user: {\n        name: '',\n        celular: '',\n        email: '',\n        password: '',\n        passwordConfirm: '',\n        nomeSite: ''\n      },\n      concordaComTermos: true,\n      error: undefined,\n      isLoading: false,\n      showSnackbar: false\n    };\n  },\n  computed: {\n    nameErrors() {\n      const errors = [];\n      const name = this.v$.user.name;\n      if (!name.$dirty) {\n        return errors;\n      }\n      !name.required.$response && errors.push('Nome é obrigatório!');\n      !name.minLength.$response && errors.push(`Insira pelo menos ${name.minLength.$params.min} caracteres!`);\n      return errors;\n    },\n    celularErrors() {\n      const errors = [];\n      const celular = this.v$.user.celular;\n      if (!celular.$dirty) {\n        return errors;\n      }\n      !celular.required.$response && errors.push('Número de celular é obrigatório!');\n      return errors;\n    },\n    emailErrors() {\n      const errors = [];\n      const email = this.v$.user.email;\n      if (!email.$dirty) {\n        return errors;\n      }\n      !email.required.$response && errors.push('Email é obrigatório!');\n      !email.email.$response && errors.push('Insira um email válido!');\n      return errors;\n    },\n    passwordErrors() {\n      const errors = [];\n      const password = this.v$.user.password;\n      if (!password.$dirty) {\n        return errors;\n      }\n      !password.required.$response && errors.push('Senha é obrigatória!');\n      !password.minLength.$response && errors.push(`Insira pelo menos ${password.minLength.$params.min} caracteres!`);\n      return errors;\n    },\n    passwordConfirmErrors() {\n      const errors = [];\n      const passwordConfirm = this.v$.user.passwordConfirm;\n      if (!passwordConfirm.$dirty) {\n        return errors;\n      }\n      this.user.password != this.user.passwordConfirm && errors.push('Senhas não correspondem!');\n      return errors;\n    },\n    nomeSiteErrors() {\n      const errors = [];\n      const nomeSite = this.v$.user.nomeSite;\n      if (!nomeSite.$dirty) {\n        return errors;\n      }\n      !nomeSite.required.$response && errors.push('Exatamente igual o título do seu site');\n      return errors;\n    }\n  },\n  validations: function () {\n    const validations = {\n      user: {\n        name: {\n          required,\n          minLength: minLength(3)\n        },\n        celular: {\n          required\n        },\n        email: {\n          required,\n          email\n        },\n        password: {\n          required,\n          minLength: minLength(8)\n        },\n        passwordConfirm: {\n          required\n        },\n        nomeSite: {\n          required\n        }\n      }\n    };\n    return {\n      user: {\n        ...validations.user\n      }\n    };\n  },\n  methods: {\n    trocarPlano() {\n      this.$emit('trocarPlano');\n    },\n    async submit() {\n      this.isLoading = true;\n      try {\n        //\n        this.$router.push(this.$route.query.redirect || '/dashboard');\n      } catch (e) {\n        this.error = e.errorMessage;\n      } finally {\n        this.error = 'login não implementado';\n        setTimeout(() => {\n          this.isLoading = false;\n        }, 5000);\n      }\n    },\n    registerUser() {\n      this.$router.push('/cadastro');\n    }\n  },\n  mounted() {\n    const customVcardForm = document.querySelector('.custom-v-card-form');\n    const cardForm = document.querySelector('.card-form');\n    const cardPlano = document.querySelector('.card-plano');\n    const customVcard = document.querySelector('.custom-v-card-plano-escolhido');\n    cardPlano.style.height = `${cardForm.offsetHeight}px`;\n    customVcard.style.height = `${customVcardForm.offsetHeight}px`;\n    cardPlano.style.maxHeight = `${cardForm.offsetHeight}px`;\n    customVcard.style.maxHeight = `${customVcardForm.offsetHeight}px`;\n  }\n};","map":{"version":3,"names":["mask","useVuelidate","required","email","minLength","name","setup","v$","props","plano","Object","directives","data","user","celular","password","passwordConfirm","nomeSite","concordaComTermos","error","undefined","isLoading","showSnackbar","computed","nameErrors","errors","$dirty","$response","push","$params","min","celularErrors","emailErrors","passwordErrors","passwordConfirmErrors","nomeSiteErrors","validations","methods","trocarPlano","$emit","submit","$router","$route","query","redirect","e","errorMessage","setTimeout","registerUser","mounted","customVcardForm","document","querySelector","cardForm","cardPlano","customVcard","style","height","offsetHeight","maxHeight"],"sources":["D:\\projetos\\locaweb\\src\\modules\\cadastro\\components\\FormularioCadastro.vue"],"sourcesContent":["<template>\r\n  <v-row class=\"mt-9 card-container\" justify=\"center\">\r\n    <v-col cols=\"5\" class=\"card-form\">\r\n      <v-card flat border rounded class=\"custom-v-card-form\">\r\n        <v-card-text>\r\n          <v-card-title class=\"text--primary titulo-login\">Dados pessoais</v-card-title>\r\n          <v-card-subtitle class=\"sub-titulo-login\" color=\"text\">Informe seus dados pessoais para acesso à sua conta</v-card-subtitle>\r\n          \r\n          <v-card-text>\r\n            <v-form>\r\n              <v-label class=\"custom-label-color mt-3\" text=\"Nome completo\"></v-label>\r\n              <v-text-field \r\n                v-model.trim=\"v$.user.name.$model\" \r\n                variant=\"outlined\" \r\n                name=\"nome-completo\" \r\n                placeholder=\"Informe seu nome completo\"\r\n                type=\"text\"\r\n                :error-messages=\"nameErrors\"\r\n                class=\"custom-text-field\">\r\n              </v-text-field>\r\n\r\n              <v-label class=\"custom-label-color mt-3\" text=\"Celular\"></v-label>\r\n              <v-text-field \r\n                v-model.trim=\"v$.user.celular.$model\" \r\n                variant=\"outlined\" \r\n                name=\"celular\" \r\n                placeholder=\"(99) 99999-0000\"\r\n                type=\"text\"\r\n                :error-messages=\"celularErrors\"\r\n                v-mask=\"'(##) #####-####'\"\r\n                class=\"custom-text-field\">\r\n              </v-text-field>\r\n\r\n              <v-label class=\"custom-label-color mt-3\" text=\"E-mail\"></v-label>\r\n              <v-text-field \r\n                v-model.trim=\"v$.user.email.$model\" \r\n                variant=\"outlined\" \r\n                name=\"email\" \r\n                placeholder=\"Seu e-mail\"\r\n                type=\"email\"\r\n                :error-messages=\"emailErrors\"\r\n                class=\"custom-text-field\">\r\n              </v-text-field>\r\n\r\n              <v-label class=\"custom-label-color mt-3\" text=\"Senha\"></v-label>\r\n              <v-text-field \r\n                v-model.trim=\"v$.user.password.$model\" \r\n                variant=\"outlined\" \r\n                name=\"password\" \r\n                placeholder=\"Sua senha\"\r\n                type=\"password\"\r\n                :error-messages=\"passwordErrors\"\r\n\r\n                class=\"custom-text-field\">\r\n              </v-text-field>\r\n\r\n              <v-label class=\"custom-label-color mt-3\" text=\"Confirme sua senha\"></v-label>\r\n              <v-text-field \r\n                v-model.trim=\"v$.user.passwordConfirm.$model\" \r\n                variant=\"outlined\" \r\n                name=\"passwordConfirmed\" \r\n                placeholder=\"Confirme sua senha\"\r\n                type=\"password\"\r\n                :error-messages=\"passwordConfirmErrors\"\r\n                class=\"custom-text-field\">\r\n              </v-text-field>\r\n            </v-form>\r\n          </v-card-text>\r\n          <v-divider class=\"mb-4 my-4\"></v-divider>\r\n\r\n          <v-card-title class=\"text--primary titulo-login\">Dados do seu site</v-card-title>\r\n          <v-card-text>\r\n            <v-label class=\"custom-label-color mt-3\" text=\"Nome do seu site\"></v-label>\r\n            <v-text-field \r\n              v-model.trim=\"v$.user.nomeSite.$model\" \r\n              variant=\"outlined\" \r\n              name=\"nome-site\" \r\n              placeholder=\"Meu site\"\r\n              type=\"text\"\r\n              :error-messages=\"nomeSiteErrors\"\r\n              class=\"custom-text-field\">\r\n            </v-text-field>\r\n          </v-card-text>\r\n\r\n          <v-divider class=\"mb-4 my-4\"></v-divider>\r\n\r\n          <v-card-text>\r\n            <label class=\"custom-checkbox\">\r\n              <input type=\"checkbox\">\r\n              <span class=\"checkmark\"></span>\r\n              Ao concluir com seu cadastro você concorda com nossos <br><a class=\"termos\">termos de uso</a> e <a class=\"politicas\">politicas de privacidade.</a>\r\n            </label>\r\n          </v-card-text>\r\n          \r\n          <v-card-text>\r\n            <v-btn block variant=\"text\" class=\"bg-primary pa-9 font-weight-regular text-uppercase text-body-1\">Criar Conta</v-btn>\r\n          </v-card-text>\r\n        </v-card-text>\r\n      </v-card>\r\n    </v-col>\r\n\r\n    <v-col cols=\"3\" class=\"card-plano\">\r\n      <v-card flat class=\"text-center pa-9 custom-v-card-plano-escolhido\">\r\n        <v-btn\r\n         variant=\"flat\"\r\n         rounded=\"lg\"\r\n         class=\"custom-v-btn-plano-escolhido\">\r\n          Plano escolhido\r\n        </v-btn>\r\n\r\n        <div class=\"conteudo-plano\">\r\n          <v-card-title class=\"custom-title\">Hospedagem {{plano.hospedagem}}</v-card-title>\r\n          <div class=\"my-4\">\r\n          \r\n            <p class=\"text-h4 custom-valor\">\r\n              <span class=\"custom-span-valor\" v-if=\"plano.valor != 'Grátis'\">R$</span>\r\n              {{ plano.valor }}\r\n              <span class=\"custom-span-valor\" v-if=\"plano.valor != 'Grátis'\">/mês</span></p>\r\n          </div>\r\n          <v-card-subtitle>{{ plano.detalheValor }}</v-card-subtitle>\r\n          <v-card-subtitle class=\"my-2\">{{ plano.taxa }}</v-card-subtitle>\r\n          <v-divider class=\"mb-4 my-4 mx-5\"></v-divider>\r\n          <div class=\"my-4 mb-4 custom-ideal\">\r\n            <p class=\"text-h6 custom-text-h6 px-9\">Ideal {{ plano.ideal }}</p>\r\n          </div>\r\n          <v-divider class=\"mb-4 my-4 mx-5\"></v-divider>\r\n          <v-card-title class=\"text-left mt-5\">\r\n            Seu site em servidores <span class=\"text-underline\">no<br>{{ plano.paisServidor}}</span>\r\n          </v-card-title>\r\n          <v-list-item>\r\n            <ul class=\"custom-list text-left\">\r\n              <li class=\"custom-list-item\"  v-for=\"(beneficio, index) in plano.beneficios\" :key=\"index\">\r\n                <v-icon icon=\"mdi-check\" class=\"custom-icon\"></v-icon>\r\n                <p class=\"custom-list-item-title\">{{ beneficio }}</p>\r\n              </li>\r\n            </ul>\r\n          </v-list-item>\r\n          <v-card-title class=\"text-left mt-5\">\r\n            Suporte 24 horas, 7 dias por <br> semana grátis;\r\n          </v-card-title>\r\n          <v-card-title class=\"text-left mt-5\">\r\n            Aplicativos disponíveis;\r\n          </v-card-title>\r\n          <v-list-item>\r\n            <ul class=\"custom-list text-left\">\r\n              <li class=\"custom-list-item\"  v-for=\"(aplicativo, index) in plano.aplicativosDisponiveis\" :key=\"index\">\r\n                <v-icon icon=\"mdi-check\" class=\"custom-icon\"></v-icon>\r\n                <p class=\"custom-list-item-title\">{{ aplicativo }}</p>\r\n              </li>\r\n            </ul>\r\n          </v-list-item>\r\n          <div v-if=\"plano.valor != 'Grátis'\">\r\n            <v-card-title class=\"text-left mt-5\">\r\n              Migração Gratuita;\r\n            </v-card-title>\r\n            <v-list-item>\r\n              <ul class=\"custom-list text-left\">\r\n                <li class=\"custom-list-item\">\r\n                  <v-icon icon=\"mdi-check\" class=\"custom-icon\"></v-icon>\r\n                  <p class=\"custom-list-item-title\">Migramos todos os seus sites <br>para nossos servidores</p>\r\n                </li>\r\n              </ul>\r\n            </v-list-item>\r\n          </div>\r\n          <v-card-title class=\"text-left mt-5\">\r\n            Você ainda tem;\r\n          </v-card-title>\r\n          <v-list-item>\r\n            <ul class=\"custom-list text-left\">\r\n              <li class=\"custom-list-item\"  v-for=\"(bonus, index) in plano.voceAindaTem\" :key=\"index\">\r\n                <v-icon icon=\"mdi-check\" class=\"custom-icon\"></v-icon>\r\n                <p class=\"custom-list-item-title\">{{ bonus }}</p>\r\n              </li>\r\n            </ul>\r\n          </v-list-item>\r\n        </div>\r\n\r\n        <div class=\"btn-trocar-plano\">\r\n          <v-btn block variant=\"outlined\" class=\"pa-7 font-weight-regular text-h6\" @click=\"trocarPlano\">Trocar plano</v-btn>\r\n        </div>\r\n      </v-card>\r\n    </v-col>\r\n  </v-row>\r\n</template>\r\n\r\n<script>\r\nimport { mask } from 'ke-the-mask';\r\nimport { useVuelidate } from '@vuelidate/core'\r\nimport { required, email, minLength } from '@vuelidate/validators'\r\n\r\nexport default { \r\n  name: 'FormCadastro',\r\n  setup() {\r\n    return { v$: useVuelidate() }\r\n  },\r\n  props: { plano: Object },\r\n  directives: {\r\n    mask\r\n  },\r\n  data() {\r\n    return { \r\n      user: {\r\n        name: '',\r\n        celular: '',\r\n        email: '',\r\n        password: '',\r\n        passwordConfirm: '',\r\n        nomeSite: ''\r\n      },\r\n      concordaComTermos: true,\r\n      error: undefined,\r\n      isLoading: false,\r\n      showSnackbar: false\r\n    }\r\n  },\r\n  computed: {\r\n    nameErrors() {\r\n      const  errors = []\r\n      const name = this.v$.user.name\r\n      \r\n      if (!name.$dirty) {\r\n        return errors\r\n      }\r\n\r\n      !name.required.$response && errors.push('Nome é obrigatório!')\r\n      !name.minLength.$response && errors.push(`Insira pelo menos ${name.minLength.$params.min} caracteres!`)\r\n      \r\n      return errors\r\n    },\r\n    celularErrors() {\r\n      const  errors = []\r\n      const celular = this.v$.user.celular\r\n      \r\n      if (!celular.$dirty) {\r\n        return errors\r\n      }\r\n\r\n      !celular.required.$response && errors.push('Número de celular é obrigatório!')\r\n      \r\n      return errors\r\n    },\r\n    emailErrors() {\r\n      const  errors = []\r\n      const email = this.v$.user.email\r\n      \r\n      if (!email.$dirty) {\r\n        return errors\r\n      }\r\n\r\n      !email.required.$response && errors.push('Email é obrigatório!')\r\n      !email.email.$response && errors.push('Insira um email válido!')\r\n\r\n      return errors\r\n    },\r\n    passwordErrors() {\r\n      const  errors = []\r\n      const password = this.v$.user.password\r\n      \r\n      if (!password.$dirty) {\r\n        return errors\r\n      }\r\n\r\n      !password.required.$response && errors.push('Senha é obrigatória!')\r\n      !password.minLength.$response && errors.push(`Insira pelo menos ${password.minLength.$params.min} caracteres!`)\r\n      \r\n      return errors\r\n    },\r\n    passwordConfirmErrors() {\r\n      const  errors = []\r\n      const passwordConfirm = this.v$.user.passwordConfirm\r\n      if (!passwordConfirm.$dirty) {\r\n        return errors\r\n      }\r\n\r\n      this.user.password != this.user.passwordConfirm && errors.push('Senhas não correspondem!')\r\n      \r\n      return errors\r\n    },\r\n    nomeSiteErrors() {\r\n      const  errors = []\r\n      const nomeSite = this.v$.user.nomeSite\r\n      \r\n      if (!nomeSite.$dirty) {\r\n        return errors\r\n      }\r\n\r\n      !nomeSite.required.$response && errors.push('Exatamente igual o título do seu site')\r\n      \r\n      return errors\r\n    }\r\n  },\r\n  validations: function () {\r\n    const validations = {\r\n      user: {\r\n        name: {\r\n          required,\r\n          minLength: minLength(3)\r\n        },\r\n        celular: {\r\n          required,\r\n        },\r\n        email: {\r\n          required,\r\n          email\r\n        },\r\n        password: {\r\n          required,\r\n          minLength: minLength(8)\r\n        },\r\n        passwordConfirm: {\r\n          required\r\n        },\r\n        nomeSite: {\r\n          required\r\n        }\r\n      }\r\n    }\r\n\r\n    return {\r\n      user: {\r\n        ...validations.user\r\n      }\r\n    }\r\n  },\r\n  methods: {\r\n    trocarPlano() {\r\n      this.$emit('trocarPlano');\r\n    },\r\n    async submit() {\r\n      this.isLoading = true;\r\n      \r\n      try {\r\n        //\r\n        this.$router.push(this.$route.query.redirect || '/dashboard')\r\n      } catch(e) {\r\n        this.error = e.errorMessage\r\n      } finally {\r\n        this.error = 'login não implementado'\r\n\r\n        setTimeout(() => {\r\n          this.isLoading = false;\r\n        }, 5000)\r\n      }\r\n    },\r\n    registerUser() {\r\n      this.$router.push('/cadastro')\r\n    }\r\n  },\r\n  mounted() {\r\n    const customVcardForm = document.querySelector('.custom-v-card-form')\r\n    const cardForm = document.querySelector('.card-form');\r\n    const cardPlano = document.querySelector('.card-plano');\r\n    const customVcard = document.querySelector('.custom-v-card-plano-escolhido');\r\n    \r\n  