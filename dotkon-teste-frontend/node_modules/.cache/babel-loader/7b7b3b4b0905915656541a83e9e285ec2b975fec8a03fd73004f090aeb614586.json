{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nimport { servicesPost } from '@/modules/dashboard/services';\nexport default {\n  name: 'DashboardView',\n  data() {\n    return {\n      userName: '',\n      userId: '',\n      value: false,\n      posts: [],\n      postForm: {\n        id: null,\n        title: '',\n        content: ''\n      },\n      loading: false\n    };\n  },\n  created() {\n    this.userName = localStorage.getItem('USER_NAME') || 'Usuário';\n    this.userId = localStorage.getItem('USER_ID') || null;\n    this.fetchPosts();\n  },\n  methods: {\n    async fetchPosts() {\n      try {\n        const response = await axios.get('/api/posts');\n        this.posts = response.data;\n      } catch (error) {\n        console.error('Erro ao buscar posts:', error);\n      }\n    },\n    async savePost() {\n      try {\n        this.loading = true;\n        if (this.postForm.id) {\n          await axios.put(`/api/posts/${this.postForm.id}`, this.postForm);\n        } else {\n          // Criar Post\n          await axios.post('/api/posts', this.postForm);\n        }\n        this.postForm = {\n          id: null,\n          title: '',\n          content: ''\n        };\n        this.fetchPosts(); // Atualizar lista de posts\n      } catch (error) {\n        console.error('Erro ao salvar post:', error);\n      } finally {\n        this.loading = false;\n      }\n    },\n    editPost(post) {\n      this.postForm = {\n        ...post\n      }; // Preencher o formulário com os dados do post\n    },\n\n    async deletePost(postId) {\n      try {\n        await axios.delete(`/api/posts/${postId}`);\n        this.fetchPosts(); // Atualizar lista de posts\n      } catch (error) {\n        console.error('Erro ao excluir post:', error);\n      }\n    },\n    logout() {\n      localStorage.removeItem('AUTH_TOKEN');\n      this.$router.push(this.$route.query.redirect || '/login');\n    }\n  }\n};","map":{"version":3,"names":["axios","servicesPost","name","data","userName","userId","value","posts","postForm","id","title","content","loading","created","localStorage","getItem","fetchPosts","methods","response","get","error","console","savePost","put","post","editPost","deletePost","postId","delete","logout","removeItem","$router","push","$route","query","redirect"],"sources":["D:\\ESTUDOS\\projetos\\locaweb\\src\\modules\\dashboard\\views\\Dashboard.vue"],"sourcesContent":["<template>\r\n  <v-row justify=\"center\">\r\n    <v-col xs=\"12\" sm=\"10\" md=\"10\" lg=\"10\" xl=\"10\">\r\n      <v-card class=\"custom-v-card-dashboad\" elevation=\"0\">\r\n        <v-layout>\r\n          <v-app-bar color=\"background\" elevation=\"0\">\r\n            <template v-slot:prepend>\r\n              <v-card\r\n                variant=\"text\"\r\n                class=\"ma-10 custom-ma d-flex justify-center align-center\"\r\n                color=\"red\"\r\n                flat\r\n              >\r\n                <h1><span class=\"blue\">Seja bem-vindo ao </span>BLOG Simples</h1>\r\n              </v-card>\r\n            </template>\r\n            <v-spacer></v-spacer>\r\n            <span class=\"custom-title mr-4\">{{ userName }}</span>\r\n            <v-btn icon @click=\"value = !value\">\r\n              <v-icon>mdi-account</v-icon>\r\n            </v-btn>\r\n            <v-btn v-show=\"value\" @click=\"logout\">\r\n              Sair\r\n            </v-btn>\r\n            <v-btn v-show=\"!userId\" @click=\"logout\">\r\n              Fazer Login\r\n            </v-btn>\r\n            <v-btn v-show=\"!userId\" @click=\"logout\">\r\n              Cadastre-se\r\n            </v-btn>\r\n          </v-app-bar>\r\n\r\n          <v-main class=\"custom-v-main\">\r\n            <v-container fluid>\r\n              <v-card class=\"pa-4 mb-4\">\r\n                <v-text-field\r\n                  label=\"Título do Post\"\r\n                  v-model=\"postForm.title\"\r\n                  outlined\r\n                  dense\r\n                ></v-text-field>\r\n                <v-textarea\r\n                  label=\"Conteúdo\"\r\n                  v-model=\"postForm.content\"\r\n                  outlined\r\n                  dense\r\n                ></v-textarea>\r\n                <v-btn\r\n                  color=\"primary\"\r\n                  class=\"mt-2\"\r\n                  @click=\"savePost\"\r\n                  :disabled=\"loading\"\r\n                >\r\n                  {{ postForm.id ? 'Editar Post' : 'Adicionar Post' }}\r\n                </v-btn>\r\n              </v-card>\r\n\r\n              <v-card\r\n                v-for=\"post in posts\"\r\n                :key=\"post.id\"\r\n                class=\"mb-3\"\r\n                outlined\r\n              >\r\n                <v-card-title>{{ post.title }}</v-card-title>\r\n                <v-card-text>{{ post.content }}</v-card-text>\r\n                <v-card-actions>\r\n                  <v-btn color=\"primary\" @click=\"editPost(post)\">Editar</v-btn>\r\n                  <v-btn color=\"red\" @click=\"deletePost(post.id)\">Excluir</v-btn>\r\n                </v-card-actions>\r\n              </v-card>\r\n            </v-container>\r\n          </v-main>\r\n        </v-layout>\r\n      </v-card>\r\n    </v-col>\r\n  </v-row>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\nimport { servicesPost } from '@/modules/dashboard/services'\r\n\r\nexport default {\r\n  name: 'DashboardView',\r\n  data() {\r\n    return {\r\n      userName: '',\r\n      userId: '',\r\n      value: false,\r\n      posts: [],\r\n      postForm: {\r\n        id: null,\r\n        title: '',\r\n        content: ''\r\n      },\r\n      loading: false\r\n    };\r\n  },\r\n  created() {\r\n    this.userName = localStorage.getItem('USER_NAME') || 'Usuário';\r\n    this.userId = localStorage.getItem('USER_ID') || null;\r\n    this.fetchPosts();\r\n  },\r\n  methods: {\r\n    async fetchPosts() {\r\n      try {\r\n        const response = await axios.get('/api/posts');\r\n        this.posts = response.data;\r\n      } catch (error) {\r\n        console.error('Erro ao buscar posts:', error);\r\n      }\r\n    },\r\n    async savePost() {\r\n      try {\r\n        this.loading = true;\r\n        if (this.postForm.id) {\r\n          await axios.put(`/api/posts/${this.postForm.id}`, this.postForm);\r\n        } else {\r\n          // Criar Post\r\n          await axios.post('/api/posts', this.postForm);\r\n        }\r\n        this.postForm = { id: null, title: '', content: '' };\r\n        this.fetchPosts(); // Atualizar lista de posts\r\n      } catch (error) {\r\n        console.error('Erro ao salvar post:', error);\r\n      } finally {\r\n        this.loading = false;\r\n      }\r\n    },\r\n    editPost(post) {\r\n      this.postForm = { ...post }; // Preencher o formulário com os dados do post\r\n    },\r\n    async deletePost(postId) {\r\n      try {\r\n        await axios.delete(`/api/posts/${postId}`);\r\n        this.fetchPosts(); // Atualizar lista de posts\r\n      } catch (error) {\r\n        console.error('Erro ao excluir post:', error);\r\n      }\r\n    },\r\n    logout() {\r\n      localStorage.removeItem('AUTH_TOKEN');\r\n      this.$router.push(this.$route.query.redirect || '/login');\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style>\r\n.custom-row-login {\r\n  overflow: auto;\r\n}\r\n\r\n.titulo-login {\r\n  font-size: 29px;\r\n  font-weight: 900;\r\n}\r\n\r\n.card-padding {\r\n  padding: 50px;\r\n}\r\n\r\n.sub-titulo-login {\r\n  font-size: 16px;\r\n  font-weight: 500;\r\n  white-space: wrap;\r\n  color: black !important;\r\n}\r\n\r\n.custom-label-color {\r\n  color: black !important;\r\n  font-weight: 500;\r\n}\r\n\r\n.v-btn--no-padding {\r\n  padding: 0 !important;\r\n}\r\n\r\n.v-btn--text-no-uppercase .v-btn__content {\r\n  text-transform: none !important;\r\n}\r\n\r\n.custom-text-field .v-field__input {\r\n  height: 70px !important; /* Ajuste o valor da altura conforme necessário */\r\n}\r\n\r\n.v-responsive.v-img.custom-v-img {\r\n  margin: 0 auto;\r\n}\r\n\r\n.box-link-criar-conta {\r\n  display: flex;\r\n  justify-content: center;\r\n  margin-top: 36px;\r\n}\r\n\r\n.box-link-criar-conta p {\r\n  font-weight: 400;\r\n  font-size: 20px;\r\n}\r\n\r\n.box-link-criar-conta span {\r\n  color: #F30168;\r\n  text-decoration: underline;\r\n  text-decoration-thickness: 1px;\r\n  cursor: pointer;\r\n}\r\n\r\n@media(max-width: 590px) {\r\n  .titulo-login {\r\n    font-size: 26px;\r\n  }\r\n  \r\n  .sub-titulo-login {\r\n    font-size: 13px;\r\n  }\r\n\r\n  .custom-ma {\r\n    margin: 20px !important;\r\n  }\r\n\r\n  .custom-pa {\r\n    padding: 25px !important;\r\n  }\r\n\r\n  .box-link-criar-conta {\r\n    margin-top: 20px;\r\n  }\r\n\r\n  .custom-v-card-text.v-card-text {\r\n    padding-top: 0px !important;\r\n  }\r\n}\r\n</style>"],"mappings":";AA+EA,OAAOA,KAAI,MAAO,OAAO;AACzB,SAASC,YAAW,QAAS,8BAA6B;AAE1D,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,MAAM,EAAE,EAAE;MACVC,KAAK,EAAE,KAAK;MACZC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE;QACRC,EAAE,EAAE,IAAI;QACRC,KAAK,EAAE,EAAE;QACTC,OAAO,EAAE;MACX,CAAC;MACDC,OAAO,EAAE;IACX,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACT,QAAO,GAAIU,YAAY,CAACC,OAAO,CAAC,WAAW,KAAK,SAAS;IAC9D,IAAI,CAACV,MAAK,GAAIS,YAAY,CAACC,OAAO,CAAC,SAAS,KAAK,IAAI;IACrD,IAAI,CAACC,UAAU,CAAC,CAAC;EACnB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,UAAUA,CAAA,EAAG;MACjB,IAAI;QACF,MAAME,QAAO,GAAI,MAAMlB,KAAK,CAACmB,GAAG,CAAC,YAAY,CAAC;QAC9C,IAAI,CAACZ,KAAI,GAAIW,QAAQ,CAACf,IAAI;MAC5B,EAAE,OAAOiB,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,uBAAuB,EAAEA,KAAK,CAAC;MAC/C;IACF,CAAC;IACD,MAAME,QAAQA,CAAA,EAAG;MACf,IAAI;QACF,IAAI,CAACV,OAAM,GAAI,IAAI;QACnB,IAAI,IAAI,CAACJ,QAAQ,CAACC,EAAE,EAAE;UACpB,MAAMT,KAAK,CAACuB,GAAG,CAAE,cAAa,IAAI,CAACf,QAAQ,CAACC,EAAG,EAAC,EAAE,IAAI,CAACD,QAAQ,CAAC;QAClE,OAAO;UACL;UACA,MAAMR,KAAK,CAACwB,IAAI,CAAC,YAAY,EAAE,IAAI,CAAChB,QAAQ,CAAC;QAC/C;QACA,IAAI,CAACA,QAAO,GAAI;UAAEC,EA