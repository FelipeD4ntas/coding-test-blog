{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { useVuelidate } from '@vuelidate/core';\nimport { required, email, minLength } from '@vuelidate/validators';\nexport default {\n  name: 'FormCadastro',\n  setup() {\n    return {\n      v$: useVuelidate()\n    };\n  },\n  props: {\n    plano: Object\n  },\n  data() {\n    return {\n      concordaComTermos: true,\n      error: undefined,\n      isLoading: false,\n      isLogin: true,\n      showSnackbar: false,\n      user: {\n        email: '',\n        password: ''\n      },\n      isNameValid: false,\n      isEmailValid: false,\n      isPasswordValid: false\n    };\n  },\n  computed: {\n    nameErrors() {\n      const errors = [];\n      const name = this.v$.user.name;\n      if (!name.$dirty) {\n        return errors;\n      }\n      !name.required.$response && errors.push('Nome é obrigatório!');\n      !name.minLength.$response && errors.push(`Insira pelo menos ${name.minLength.$params.min} caracteres!`);\n      return errors;\n    },\n    emailErrors() {\n      const errors = [];\n      const email = this.v$.user.email;\n      if (!email.$dirty) {\n        return errors;\n      }\n      !email.required.$response && errors.push('Email é obrigatório!');\n      !email.email.$response && errors.push('Insira um email válido!');\n      return errors;\n    },\n    passwordErrors() {\n      const errors = [];\n      const password = this.v$.user.password;\n      if (!password.$dirty) {\n        return errors;\n      }\n      !password.required.$response && errors.push('Senha é obrigatória!');\n      !password.minLength.$response && errors.push(`Insira pelo menos ${password.minLength.$params.min} caracteres!`);\n      return errors;\n    }\n  },\n  validations: function () {\n    const validations = {\n      user: {\n        email: {\n          required,\n          email\n        },\n        password: {\n          required,\n          minLength: minLength(6)\n        }\n      }\n    };\n    if (this.isLogin) {\n      this.user.name = '';\n      return validations;\n    }\n    return {\n      user: {\n        ...validations.user,\n        name: {\n          required,\n          minLength: minLength(3)\n        }\n      }\n    };\n  },\n  watch: {\n    ['v$.user.name.$invalid']() {\n      if (this.v$.user.name) {\n        if (!this.v$.user.name.$invalid) {\n          this.isNameValid = true;\n        } else {\n          this.isNameValid = false;\n        }\n      }\n    },\n    ['v$.user.email.$invalid']() {\n      if (!this.v$.user.email.$invalid) {\n        this.isEmailValid = true;\n      } else {\n        this.isEmailValid = false;\n      }\n    },\n    ['v$.user.password.$invalid']() {\n      if (!this.v$.user.password.$invalid) {\n        this.isPasswordValid = true;\n      } else {\n        this.isPasswordValid = false;\n      }\n    }\n  },\n  methods: {\n    async submit() {\n      this.isLoading = true;\n      try {\n        //\n        this.$router.push(this.$route.query.redirect || '/dashboard');\n      } catch (e) {\n        this.error = e.errorMessage;\n        this.showSnackbar = true;\n      } finally {\n        this.error = 'login não implementado';\n        this.showSnackbar = true;\n        setTimeout(() => {\n          this.isLoading = false;\n        }, 5000);\n      }\n    },\n    registerUser() {\n      this.$router.push('/cadastro');\n    }\n  }\n};","map":{"version":3,"names":["useVuelidate","required","email","minLength","name","setup","v$","props","plano","Object","data","concordaComTermos","error","undefined","isLoading","isLogin","showSnackbar","user","password","isNameValid","isEmailValid","isPasswordValid","computed","nameErrors","errors","$dirty","$response","push","$params","min","emailErrors","passwordErrors","validations","watch","v$.user.name.$invalid","$invalid","v$.user.email.$invalid","v$.user.password.$invalid","methods","submit","$router","$route","query","redirect","e","errorMessage","setTimeout","registerUser"],"sources":["D:\\projetos\\locaweb\\src\\modules\\cadastro\\components\\FormularioCadastro.vue"],"sourcesContent":["<template>\r\n  <v-row class=\"mt-9 card-container\" justify=\"center\">\r\n    <v-col cols=\"5\" class=\"card-form\">\r\n      <v-card flat border rounded>\r\n        <v-card-text>\r\n          <v-card-title class=\"text--primary titulo-login\">Dados pessoais</v-card-title>\r\n          <v-card-subtitle class=\"sub-titulo-login\" color=\"text\">Informe seus dados pessoais para acesso à sua conta</v-card-subtitle>\r\n          \r\n          <v-card-text>\r\n            <v-form>\r\n              <v-label class=\"custom-label-color\" text=\"Nome completo\"></v-label>\r\n              <v-text-field \r\n                v-model.trim=\"v$.user.email.$model\" \r\n                variant=\"outlined\" \r\n                name=\"nome-completo\" \r\n                placeholder=\"Informe seu nome completo\"\r\n                type=\"text\"\r\n                :error-messages=\"emailErrors\"\r\n                :color=\"isEmailValid ? 'success' : 'default'\">\r\n              </v-text-field>\r\n\r\n              <v-label class=\"custom-label-color\" text=\"Celular\"></v-label>\r\n              <v-text-field \r\n                v-model.trim=\"v$.user.email.$model\" \r\n                variant=\"outlined\" \r\n                name=\"celular\" \r\n                placeholder=\"(99) 99999-0000\"\r\n                type=\"text\"\r\n                :error-messages=\"emailErrors\"\r\n                :color=\"isEmailValid ? 'success' : 'default'\">\r\n              </v-text-field>\r\n\r\n              <v-label class=\"custom-label-color\" text=\"E-mail\"></v-label>\r\n              <v-text-field \r\n                v-model.trim=\"v$.user.email.$model\" \r\n                variant=\"outlined\" \r\n                name=\"email\" \r\n                placeholder=\"Seu e-mail\"\r\n                type=\"email\"\r\n                :error-messages=\"emailErrors\"\r\n                :color=\"isEmailValid ? 'success' : 'default'\">\r\n              </v-text-field>\r\n\r\n              <v-label class=\"custom-label-color mt-3\" text=\"Senha\"></v-label>\r\n              <v-text-field \r\n                v-model.trim=\"v$.user.password.$model\" \r\n                variant=\"outlined\" \r\n                name=\"password\" \r\n                placeholder=\"Sua senha\"\r\n                type=\"password\"\r\n                :error-messages=\"passwordErrors\"\r\n                :color=\"isPasswordValid ? 'success' : 'default'\"\r\n                class=\"custom-text-field\">\r\n              </v-text-field>\r\n\r\n              <v-label class=\"custom-label-color mt-3\" text=\"Confirme sua senha\"></v-label>\r\n              <v-text-field \r\n                v-model.trim=\"v$.user.password.$model\" \r\n                variant=\"outlined\" \r\n                name=\"passwordConfirmed\" \r\n                placeholder=\"Confirme sua senha\"\r\n                type=\"password\"\r\n                :error-messages=\"passwordErrors\"\r\n                :color=\"isPasswordValid ? 'success' : 'default'\"\r\n                class=\"custom-text-field\">\r\n              </v-text-field>\r\n            </v-form>\r\n          </v-card-text>\r\n          <v-divider class=\"mb-4 my-4\"></v-divider>\r\n\r\n          <v-card-title class=\"text--primary titulo-login\">Dados do seu site</v-card-title>\r\n          <v-card-text>\r\n            <v-label class=\"custom-label-color mt-3\" text=\"Nome do seu site\"></v-label>\r\n            <v-text-field \r\n              v-model.trim=\"v$.user.password.$model\" \r\n              variant=\"outlined\" \r\n              name=\"nome-site\" \r\n              placeholder=\"Meu site\"\r\n              type=\"text\"\r\n              :error-messages=\"passwordErrors\"\r\n              :color=\"isPasswordValid ? 'success' : 'default'\"\r\n              class=\"custom-text-field\">\r\n            </v-text-field>\r\n          </v-card-text>\r\n\r\n          <v-divider class=\"mb-4 my-4\"></v-divider>\r\n\r\n          <v-card-text>\r\n            <label class=\"custom-checkbox\">\r\n              <input type=\"checkbox\">\r\n              <span class=\"checkmark\"></span>\r\n              Ao concluir com seu cadastro você concorda com nossos <br><a class=\"termos\">termos de uso</a> e <a class=\"politicas\">politicas de privacidade.</a>\r\n            </label>\r\n          </v-card-text>\r\n          \r\n          <v-card-text>\r\n            <v-btn block variant=\"text\" class=\"bg-primary pa-9 font-weight-regular text-uppercase text-body-1\">Criar Conta</v-btn>\r\n          </v-card-text>\r\n        </v-card-text>\r\n      </v-card>\r\n    </v-col>\r\n\r\n    <v-col cols=\"3\" class=\"card-plano\">\r\n      <v-card flat class=\"text-center pa-9 custom-v-card\">\r\n        <v-btn\r\n         variant=\"flat\"\r\n         rounded=\"lg\"\r\n         class=\"custom-v-btn-plano-escolhido\">\r\n          Plano escolhido\r\n        </v-btn>\r\n\r\n        <div class=\"conteudo-plano\">\r\n          <v-card-title class=\"custom-title\">Hospedagem {{plano.hospedagem}}</v-card-title>\r\n          <div class=\"my-4\">\r\n          \r\n            <p class=\"text-h4 custom-valor\">\r\n              <span class=\"custom-span-valor\" v-if=\"plano.valor != 'Grátis'\">R$</span>\r\n              {{ plano.valor }}\r\n              <span class=\"custom-span-valor\" v-if=\"plano.valor != 'Grátis'\">/mês</span></p>\r\n          </div>\r\n          <v-card-subtitle>{{ plano.detalheValor }}</v-card-subtitle>\r\n          <v-card-subtitle class=\"my-2\">{{ plano.taxa }}</v-card-subtitle>\r\n          <v-divider class=\"mb-4 my-4 mx-5\"></v-divider>\r\n          <div class=\"my-4 mb-4 custom-ideal\">\r\n            <p class=\"text-h6 custom-text-h6 px-9\">Ideal {{ plano.ideal }}</p>\r\n          </div>\r\n          <v-divider class=\"mb-4 my-4 mx-5\"></v-divider>\r\n          <v-card-title class=\"text-left mt-5\">\r\n            Seu site em servidores <span class=\"text-underline\">no<br>{{ plano.paisServidor}}</span>\r\n          </v-card-title>\r\n          <v-list-item>\r\n            <ul class=\"custom-list text-left\">\r\n              <li class=\"custom-list-item\"  v-for=\"(beneficio, index) in plano.beneficios\" :key=\"index\">\r\n                <v-icon icon=\"mdi-check\" class=\"custom-icon\"></v-icon>\r\n                <p class=\"custom-list-item-title\">{{ beneficio }}</p>\r\n              </li>\r\n            </ul>\r\n          </v-list-item>\r\n          <v-card-title class=\"text-left mt-5\">\r\n            Suporte 24 horas, 7 dias por <br> semana grátis;\r\n          </v-card-title>\r\n          <v-card-title class=\"text-left mt-5\">\r\n            Aplicativos disponíveis;\r\n          </v-card-title>\r\n          <v-list-item>\r\n            <ul class=\"custom-list text-left\">\r\n              <li class=\"custom-list-item\"  v-for=\"(aplicativo, index) in plano.aplicativosDisponiveis\" :key=\"index\">\r\n                <v-icon icon=\"mdi-check\" class=\"custom-icon\"></v-icon>\r\n                <p class=\"custom-list-item-title\">{{ aplicativo }}</p>\r\n              </li>\r\n            </ul>\r\n          </v-list-item>\r\n          <div v-if=\"plano.valor != 'Grátis'\">\r\n            <v-card-title class=\"text-left mt-5\">\r\n              Migração Gratuita;\r\n            </v-card-title>\r\n            <v-list-item>\r\n              <ul class=\"custom-list text-left\">\r\n                <li class=\"custom-list-item\">\r\n                  <v-icon icon=\"mdi-check\" class=\"custom-icon\"></v-icon>\r\n                  <p class=\"custom-list-item-title\">Migramos todos os seus sites <br>para nossos servidores</p>\r\n                </li>\r\n              </ul>\r\n            </v-list-item>\r\n          </div>\r\n          <!-- <v-card-title class=\"text-left mt-5\">\r\n            Você ainda tem;\r\n          </v-card-title>\r\n          <v-list-item>\r\n            <ul class=\"custom-list text-left\">\r\n              <li class=\"custom-list-item\"  v-for=\"(bonus, index) in plano.voceAindaTem\" :key=\"index\">\r\n                <v-icon icon=\"mdi-check\" class=\"custom-icon\"></v-icon>\r\n                <p class=\"custom-list-item-title\">{{ bonus }}</p>\r\n              </li>\r\n            </ul>\r\n          </v-list-item> -->\r\n        </div>\r\n\r\n        <div class=\"btn-trocar-plano\">\r\n          <v-btn block variant=\"outlined\" class=\"pa-7 font-weight-regular text-h6\">Trocar plano</v-btn>\r\n        </div>\r\n      </v-card>\r\n    </v-col>\r\n  </v-row>\r\n</template>\r\n\r\n<script>\r\nimport { useVuelidate } from '@vuelidate/core'\r\nimport { required, email, minLength } from '@vuelidate/validators'\r\n\r\nexport default { \r\n  name: 'FormCadastro',\r\n  setup() {\r\n    return { v$: useVuelidate() }\r\n  },\r\n  props: { plano: Object },\r\n  data() {\r\n    return { \r\n      concordaComTermos: true,\r\n      error: undefined,\r\n      isLoading: false,\r\n      isLogin: true,\r\n      showSnackbar: false,\r\n      user: {\r\n        email: '',\r\n        password: ''\r\n      },\r\n      isNameValid: false,\r\n      isEmailValid: false,\r\n      isPasswordValid: false,\r\n    }\r\n  },\r\n  computed: {\r\n    nameErrors() {\r\n      const  errors = []\r\n      const name = this.v$.user.name\r\n      \r\n      if (!name.$dirty) {\r\n        return errors\r\n      }\r\n\r\n      !name.required.$response && errors.push('Nome é obrigatório!')\r\n      !name.minLength.$response && errors.push(`Insira pelo menos ${name.minLength.$params.min} caracteres!`)\r\n      \r\n      return errors\r\n    },\r\n    emailErrors() {\r\n      const  errors = []\r\n      const email = this.v$.user.email\r\n      \r\n      if (!email.$dirty) {\r\n        return errors\r\n      }\r\n\r\n      !email.required.$response && errors.push('Email é obrigatório!')\r\n      !email.email.$response && errors.push('Insira um email válido!')\r\n\r\n      return errors\r\n    },\r\n    passwordErrors() {\r\n      const  errors = []\r\n      const password = this.v$.user.password\r\n      \r\n      if (!password.$dirty) {\r\n        return errors\r\n      }\r\n\r\n      !password.required.$response && errors.push('Senha é obrigatória!')\r\n      !password.minLength.$response && errors.push(`Insira pelo menos ${password.minLength.$params.min} caracteres!`)\r\n      \r\n      return errors\r\n    }\r\n  },\r\n  validations: function () {\r\n    const validations = {\r\n      user: {\r\n        email: {\r\n          required,\r\n          email\r\n        },\r\n        password: {\r\n          required,\r\n          minLength: minLength(6)\r\n        }\r\n      }\r\n    }\r\n\r\n    if (this.isLogin) {\r\n      this.user.name = ''\r\n      return validations\r\n    }\r\n\r\n    return {\r\n      user: {\r\n        ...validations.user,\r\n        name: {\r\n          required,\r\n          minLength: minLength(3)\r\n        }\r\n      }\r\n    }\r\n  },\r\n  watch: {\r\n    ['v$.user.name.$invalid']() {\r\n     if (this.v$.user.name) {\r\n       if(!this.v$.user.name.$invalid) {\r\n          this.isNameValid = true;\r\n        } else {\r\n          this.isNameValid = false;\r\n        }\r\n     }\r\n     \r\n    },\r\n    ['v$.user.email.$invalid']() {\r\n      if(!this.v$.user.email.$invalid) {\r\n        this.isEmailValid = true;\r\n      } else {\r\n        this.isEmailValid = false;\r\n      }\r\n    },\r\n    ['v$.user.password.$invalid']() {\r\n      if(!this.v$.user.password.$invalid) {\r\n        this.isPasswordValid = true;\r\n      } else {\r\n        this.isPasswordValid = false;\r\n      }\r\n    },\r\n  },\r\n  methods: {\r\n    async submit() {\r\n      this.isLoading = true;\r\n      \r\n      try {\r\n        //\r\n        this.$router.push(this.$route.query.redirect || '/dashboard')\r\n      } catch(e) {\r\n        this.error = e.errorMessage\r\n        this.showSnackbar = true\r\n 