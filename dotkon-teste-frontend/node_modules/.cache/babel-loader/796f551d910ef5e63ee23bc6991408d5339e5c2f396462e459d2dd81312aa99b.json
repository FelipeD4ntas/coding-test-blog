{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { useVuelidate } from '@vuelidate/core';\nimport { required, email, minLength } from '@vuelidate/validators';\nimport { serviceLogin } from '@/modules/login/services';\nexport default {\n  name: 'LoginView',\n  setup() {\n    return {\n      v$: useVuelidate()\n    };\n  },\n  data() {\n    return {\n      error: undefined,\n      isLoading: false,\n      user: {\n        email: '',\n        password: ''\n      }\n    };\n  },\n  computed: {\n    emailErrors() {\n      const errors = [];\n      const email = this.v$.user.email;\n      if (!email.$dirty) {\n        return errors;\n      }\n      !email.required.$response && errors.push('Email é obrigatório!');\n      !email.email.$response && errors.push('Insira um email válido!');\n      return errors;\n    },\n    passwordErrors() {\n      const errors = [];\n      const password = this.v$.user.password;\n      if (!password.$dirty) {\n        return errors;\n      }\n      !password.required.$response && errors.push('Senha é obrigatória!');\n      !password.minLength.$response && errors.push(`Insira pelo menos ${password.minLength.$params.min} caracteres!`);\n      return errors;\n    }\n  },\n  validations: function () {\n    const validations = {\n      user: {\n        email: {\n          required,\n          email\n        },\n        password: {\n          required,\n          minLength: minLength(6)\n        }\n      }\n    };\n    return {\n      user: {\n        ...validations.user\n      }\n    };\n  },\n  methods: {\n    async submit() {\n      this.isLoading = true;\n      const bodyUser = {\n        username: \"mor_2314\",\n        password: \"83r5^_\"\n      };\n      try {\n        const response = await serviceLogin.login('auth/login', bodyUser);\n        this.$router.push(this.$route.query.redirect || '/dashboard');\n        localStorage.setItem('AUTH_TOKEN', response.data.token);\n        this.isLoading = false;\n      } catch (e) {\n        console.log(e);\n      }\n    },\n    registerUser() {\n      this.$router.push('/cadastro');\n    }\n  }\n};","map":{"version":3,"names":["useVuelidate","required","email","minLength","serviceLogin","name","setup","v$","data","error","undefined","isLoading","user","password","computed","emailErrors","errors","$dirty","$response","push","passwordErrors","$params","min","validations","methods","submit","bodyUser","username","response","login","$router","$route","query","redirect","localStorage","setItem","token","e","console","log","registerUser"],"sources":["D:\\projetos\\locaweb\\src\\modules\\login\\views\\Login.vue"],"sourcesContent":["<template>\r\n  <v-row justify=\"center\" align=\"center\" class=\"h-screen\">\r\n    <v-col xs=\"12\" sm=\"6\" md=\"4\" lg=\"3\" xl=\"3\" class=\"custom-col-login\">\r\n      <v-card variant=\"text\" class=\"ma-10 custom-ma\">\r\n        <v-img src=\"@/assets/logo.png\" :width=\"200\" class=\"custom-v-img\"></v-img>\r\n      </v-card>\r\n\r\n      <v-card flat border rounded>\r\n        <v-card-text class=\"custom-v-card-text\">\r\n\r\n          <v-card-text>\r\n            <v-progress-circular\r\n              v-show=\"isLoading\"\r\n              indeterminate\r\n              color=\"primary\">\r\n            </v-progress-circular>\r\n          </v-card-text>\r\n\r\n          <v-card-title class=\"text--primary titulo-login\">Entre na sua conta</v-card-title>\r\n          <v-card-subtitle class=\"sub-titulo-login\" color=\"text\">Para aceesar sua conta informe seu e-mail e senha</v-card-subtitle>\r\n          \r\n          <v-card-text>\r\n            <v-form>\r\n              <v-label class=\"custom-label-color\" text=\"E-mail\"></v-label>\r\n              <v-text-field \r\n                v-model.trim=\"v$.user.email.$model\" \r\n                variant=\"outlined\" \r\n                name=\"email\" \r\n                placeholder=\"Seu e-mail\"\r\n                type=\"email\"\r\n                :error-messages=\"emailErrors\">\r\n              </v-text-field>\r\n\r\n              <v-label class=\"custom-label-color mt-3\" text=\"Senha\"></v-label>\r\n              <v-text-field \r\n                v-model.trim=\"v$.user.password.$model\" \r\n                variant=\"outlined\" \r\n                name=\"password\" \r\n                placeholder=\"Sua senha\"\r\n                type=\"password\"\r\n                :error-messages=\"passwordErrors\">\r\n              </v-text-field>\r\n              <v-btn variant=\"plain\" flat class=\"float-right v-btn--no-padding v-btn--text-no-uppercase text-body-1 mt-n2\">Esqueci minha senha</v-btn>\r\n            </v-form>\r\n          </v-card-text>\r\n\r\n          <v-card-text>\r\n            <v-btn block variant=\"text\" class=\"bg-primary pa-10 custom-pa font-weight-regular text-uppercase text-body-1\" :disabled=\"v$.$invalid\" @click=\"submit\">Fazer Login</v-btn>\r\n          </v-card-text>\r\n        </v-card-text>\r\n      </v-card>\r\n\r\n      <div class=\"box-link-criar-conta\">\r\n        <p>Ainda não tem conta? \r\n          <span @click=\"registerUser\">Cadastre-se</span>\r\n        </p>\r\n      </div>\r\n    </v-col>\r\n  </v-row>\r\n</template>\r\n\r\n<script>\r\nimport { useVuelidate } from '@vuelidate/core'\r\nimport { required, email, minLength } from '@vuelidate/validators'\r\nimport { serviceLogin } from '@/modules/login/services'\r\n\r\nexport default {\r\n  name: 'LoginView',\r\n  setup() {\r\n    return { v$: useVuelidate() }\r\n  },\r\n  data() {\r\n    return {\r\n      error: undefined,\r\n      isLoading: false,\r\n      user: {\r\n        email: '',\r\n        password: ''\r\n      }\r\n    }\r\n  },\r\n  computed: {\r\n    emailErrors() {\r\n      const  errors = []\r\n      const email = this.v$.user.email\r\n      \r\n      if (!email.$dirty) {\r\n        return errors\r\n      }\r\n\r\n      !email.required.$response && errors.push('Email é obrigatório!')\r\n      !email.email.$response && errors.push('Insira um email válido!')\r\n\r\n      return errors\r\n    },\r\n    passwordErrors() {\r\n      const  errors = []\r\n      const password = this.v$.user.password\r\n      \r\n      if (!password.$dirty) {\r\n        return errors\r\n      }\r\n\r\n      !password.required.$response && errors.push('Senha é obrigatória!')\r\n      !password.minLength.$response && errors.push(`Insira pelo menos ${password.minLength.$params.min} caracteres!`)\r\n      \r\n      return errors\r\n    }\r\n  },\r\n  validations: function () {\r\n    const validations = {\r\n      user: {\r\n        email: {\r\n          required,\r\n          email\r\n        },\r\n        password: {\r\n          required,\r\n          minLength: minLength(6)\r\n        }\r\n      }\r\n    }\r\n\r\n    return {\r\n      user: {\r\n        ...validations.user\r\n      }\r\n    }\r\n  },\r\n  methods: {\r\n    async submit() {\r\n      this.isLoading = true;\r\n\r\n      const bodyUser =  {\r\n          username:\"mor_2314\",\r\n          password: \"83r5^_\"\r\n      }\r\n\r\n      try {\r\n        const response = await serviceLogin.login('auth/login', bodyUser);\r\n        this.$router.push(this.$route.query.redirect || '/dashboard');\r\n        localStorage.setItem('AUTH_TOKEN', response.data.token);\r\n        this.isLoading = false;\r\n      } catch(e) {\r\n        console.log(e);\r\n      }\r\n    },\r\n    registerUser() {\r\n      this.$router.push('/cadastro');\r\n    }\r\n  },\r\n}\r\n</script>\r\n\r\n<style>\r\n.custom-col-login {\r\n  overflow: auto;\r\n}\r\n\r\n.titulo-login {\r\n  font-size: 29px;\r\n  font-weight: 900;\r\n}\r\n\r\n.card-padding {\r\n  padding: 50px;\r\n}\r\n\r\n.sub-titulo-login {\r\n  font-size: 16px;\r\n  font-weight: 500;\r\n  white-space: wrap;\r\n  color: black !important;\r\n}\r\n\r\n.custom-label-color {\r\n  color: black !important;\r\n  font-weight: 500;\r\n}\r\n\r\n.v-btn--no-padding {\r\n  padding: 0 !important;\r\n}\r\n\r\n.v-btn--text-no-uppercase .v-btn__content {\r\n  text-transform: none !important;\r\n}\r\n\r\n.custom-text-field .v-field__input {\r\n  height: 70px !important; /* Ajuste o valor da altura conforme necessário */\r\n}\r\n\r\n.v-responsive.v-img.custom-v-img {\r\n  margin: 0 auto;\r\n}\r\n\r\n.box-link-criar-conta {\r\n  display: flex;\r\n  justify-content: center;\r\n  margin-top: 36px;\r\n}\r\n\r\n.box-link-criar-conta p {\r\n  font-weight: 400;\r\n  font-size: 20px;\r\n}\r\n\r\n.box-link-criar-conta span {\r\n  color: #F30168;\r\n  text-decoration: underline;\r\n  text-decoration-thickness: 1px;\r\n  cursor: pointer;\r\n}\r\n\r\n@media(max-width: 590px) {\r\n  .titulo-login {\r\n    font-size: 26px;\r\n  }\r\n  \r\n  .sub-titulo-login {\r\n    font-size: 13px;\r\n  }\r\n\r\n  .custom-ma {\r\n    margin: 20px !important;\r\n  }\r\n\r\n  .custom-pa {\r\n    padding: 25px !important;\r\n  }\r\n\r\n  .box-link-criar-conta {\r\n    margin-top: 20px;\r\n  }\r\n\r\n  .custom-v-card-text.v-card-text {\r\n    padding-top: 0px !important;\r\n  }\r\n}\r\n</style>"],"mappings":";AA8DA,SAASA,YAAW,QAAS,iBAAgB;AAC7C,SAASC,QAAQ,EAAEC,KAAK,EAAEC,SAAQ,QAAS,uBAAsB;AACjE,SAASC,YAAW,QAAS,0BAAyB;AAEtD,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,KAAKA,CAAA,EAAG;IACN,OAAO;MAAEC,EAAE,EAAEP,YAAY,CAAC;IAAE;EAC9B,CAAC;EACDQ,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAEC,SAAS;MAChBC,SAAS,EAAE,KAAK;MAChBC,IAAI,EAAE;QACJV,KAAK,EAAE,EAAE;QACTW,QAAQ,EAAE;MACZ;IACF;EACF,CAAC;EACDC,QAAQ,EAAE;IACRC,WAAWA,CAAA,EAAG;MACZ,MAAOC,MAAK,GAAI,EAAC;MACjB,MAAMd,KAAI,GAAI,IAAI,CAACK,EAAE,CAACK,IAAI,CAACV,KAAI;MAE/B,IAAI,CAACA,KAAK,CAACe,MAAM,EAAE;QACjB,OAAOD,MAAK;MACd;MAEA,CAACd,KAAK,CAACD,QAAQ,CAACiB,SAAQ,IAAKF,MAAM,CAACG,IAAI,CAAC,sBAAsB;MAC/D,CAACjB,KAAK,CAACA,KAAK,CAACgB,SAAQ,IAAKF,MAAM,CAACG,IAAI,CAAC,yBAAyB;MAE/D,OAAOH,MAAK;IACd,CAAC;IACDI,cAAcA,CAAA,EAAG;MACf,MAAOJ,MAAK,GAAI,EAAC;MACjB,MAAMH,QAAO,GAAI,IAAI,CAACN,EAAE,CAACK,IAAI,CAACC,QAAO;MAErC,IAAI,CAACA,QAAQ,CAACI,MAAM,EAAE;QACpB,OAAOD,MAAK;MACd;MAEA,CAACH,QAAQ,CAACZ,QAAQ,CAACiB,SAAQ,IAAKF,MA