{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { servicesPost } from '@/modules/dashboard/services';\nexport default {\n  name: 'DashboardView',\n  data() {\n    return {\n      userName: '',\n      userId: '',\n      value: false,\n      posts: [],\n      postForm: {\n        id: null,\n        titulo: '',\n        conteudo: ''\n      },\n      loading: false,\n      newPostNotification: false,\n      webSocket: null\n    };\n  },\n  created() {\n    this.userName = localStorage.getItem('USER_NAME') || 'Usuário';\n    this.userId = localStorage.getItem('USER_ID') || null;\n    this.fetchPosts();\n    this.initializeWebSocket();\n  },\n  unmounted() {\n    if (this.webSocket) {\n      this.webSocket.close();\n    }\n  },\n  methods: {\n    initializeWebSocket() {\n      // Inicializa a conexão WebSocket\n      const protocol = window.location.protocol === 'https:' ? 'wss' : 'ws';\n      const wsUrl = `${protocol}://${window.location.host}/ws`;\n      this.webSocket = new WebSocket(wsUrl);\n\n      // Evento para mensagem recebida\n      this.webSocket.onmessage = event => {\n        const message = event.data;\n        console.log('Mensagem recebida do WebSocket:', message);\n\n        // Exibe o snackbar quando uma nova mensagem for recebida\n        if (message === 'Novo post publicado!') {\n          this.newPostNotification = true;\n          this.fetchPosts(); // Atualiza os posts no front-end\n        }\n      };\n\n      // Evento de erro\n      this.webSocket.onerror = error => {\n        console.error('Erro no WebSocket:', error);\n      };\n\n      // Evento de fechamento\n      this.webSocket.onclose = () => {\n        console.warn('WebSocket desconectado. Tentando reconectar em 5 segundos...');\n        setTimeout(this.initializeWebSocket, 5000); // Reestabelece a conexão\n      };\n    },\n\n    async fetchPosts() {\n      try {\n        const response = await servicesPost.listar('postagem/postagens');\n        this.posts = response.data.dados.postagens;\n      } catch (error) {\n        console.error('Erro ao buscar posts:', error);\n      }\n    },\n    async savePost() {\n      try {\n        this.loading = true;\n        if (this.postForm.id) {\n          await servicesPost.editar(`postagem/${this.postForm.id}`, this.postForm);\n        } else {\n          await servicesPost.adicionar('postagem', this.postForm);\n          this.snackbar = true;\n        }\n        this.postForm = {\n          id: null,\n          titulo: '',\n          conteudo: ''\n        };\n        this.fetchPosts();\n      } catch (error) {\n        console.error('Erro ao salvar post:', error);\n      } finally {\n        this.loading = false;\n      }\n    },\n    editPost(post) {\n      this.postForm = {\n        ...post\n      };\n    },\n    async deletePost(postId) {\n      try {\n        await servicesPost.deletar(`postagem/${postId}`);\n        this.fetchPosts();\n      } catch (error) {\n        console.error('Erro ao excluir post:', error);\n      }\n    },\n    logout() {\n      localStorage.removeItem('AUTH_TOKEN');\n      localStorage.removeItem('USER_NAME');\n      localStorage.removeItem('USER_ID');\n      this.$router.push(this.$route.query.redirect || '/login');\n    },\n    formatarData(data) {\n      const options = {\n        day: '2-digit',\n        month: '2-digit',\n        year: 'numeric'\n      };\n      return new Date(data).toLocaleDateString('pt-BR', options);\n    }\n  }\n};","map":{"version":3,"names":["servicesPost","name","data","userName","userId","value","posts","postForm","id","titulo","conteudo","loading","newPostNotification","webSocket","created","localStorage","getItem","fetchPosts","initializeWebSocket","unmounted","close","methods","protocol","window","location","wsUrl","host","WebSocket","onmessage","event","message","console","log","onerror","error","onclose","warn","setTimeout","response","listar","dados","postagens","savePost","editar","adicionar","snackbar","editPost","post","deletePost","postId","deletar","logout","removeItem","$router","push","$route","query","redirect","formatarData","options","day","month","year","Date","toLocaleDateString"],"sources":["D:\\ESTUDOS\\projetos\\locaweb\\src\\modules\\dashboard\\views\\Dashboard.vue"],"sourcesContent":["<template>\r\n  <v-row justify=\"center\">\r\n    <v-col xs=\"12\" sm=\"10\" md=\"10\" lg=\"10\" xl=\"10\">\r\n      <v-card class=\"custom-v-card-dashboad\" elevation=\"0\">\r\n        <v-layout>\r\n          <v-app-bar color=\"background\" elevation=\"0\">\r\n            <template v-slot:prepend>\r\n              <v-card\r\n                variant=\"text\"\r\n                class=\"ma-10 custom-ma d-flex justify-center align-center\"\r\n                color=\"red\"\r\n                flat\r\n              >\r\n                <h1><span class=\"blue\">Seja bem-vindo ao </span>BLOG Simples</h1>\r\n              </v-card>\r\n            </template>\r\n            <v-spacer></v-spacer>\r\n            <span class=\"custom-titulo mr-4\">{{ userName }}</span>\r\n            <v-btn icon @click=\"value = !value\">\r\n              <v-icon>mdi-account</v-icon>\r\n            </v-btn>\r\n            <v-btn v-show=\"value\" @click=\"logout\">\r\n              Sair\r\n            </v-btn>\r\n            <v-btn v-show=\"!userId\" @click=\"logout\">\r\n              Fazer Login\r\n            </v-btn>\r\n            <v-btn v-show=\"!userId\" @click=\"logout\">\r\n              Cadastre-se\r\n            </v-btn>\r\n          </v-app-bar>\r\n\r\n          <v-main class=\"custom-v-main\">\r\n            <v-container fluid>\r\n              <v-card class=\"pa-4 mb-4\" v-show=\"userId\">\r\n                <v-text-field\r\n                  label=\"Título do Post\"\r\n                  v-model=\"postForm.titulo\"\r\n                  outlined\r\n                  dense\r\n                ></v-text-field>\r\n                <v-textarea\r\n                  label=\"Conteúdo\"\r\n                  v-model=\"postForm.conteudo\"\r\n                  outlined\r\n                  dense\r\n                ></v-textarea>\r\n                <v-btn\r\n                  color=\"primary\"\r\n                  class=\"mt-2\"\r\n                  @click=\"savePost\"\r\n                  :disabled=\"loading\"\r\n                >\r\n                  {{ postForm.id ? 'Editar Post' : 'Adicionar Post' }}\r\n                </v-btn>\r\n              </v-card>\r\n\r\n              <v-card\r\n                v-for=\"post in posts\"\r\n                :key=\"post.id\"\r\n                class=\"mb-3\"\r\n                outlined\r\n              >\r\n                <v-card-title>{{ post.titulo }}</v-card-title>\r\n                <v-card-subtitle>\r\n                  Por {{ post.nomeAutor }} em {{ formatarData(post.dataPublicacao) }}\r\n                </v-card-subtitle>\r\n                <v-card-text>{{ post.conteudo }}</v-card-text>\r\n                <v-card-actions>\r\n                  <v-btn v-show=\"userId && post.autorId === userId\" color=\"primary\" @click=\"editPost(post)\">Editar</v-btn>\r\n                  <v-btn v-show=\"userId && post.autorId === userId\" color=\"red\" @click=\"deletePost(post.id)\">Excluir</v-btn>\r\n                </v-card-actions>\r\n              </v-card>\r\n            </v-container>\r\n          </v-main>\r\n        </v-layout>\r\n      </v-card>\r\n    </v-col>\r\n  </v-row>\r\n\r\n  <v-snackbar v-model=\"newPostNotification\" timeout=\"5000\">\r\n    Nova postagem foi adicionada!\r\n  </v-snackbar>\r\n</template>\r\n\r\n<script>\r\nimport { servicesPost } from '@/modules/dashboard/services'\r\n\r\nexport default {\r\n  name: 'DashboardView',\r\n  data() {\r\n    return {\r\n      userName: '',\r\n      userId: '',\r\n      value: false,\r\n      posts: [],\r\n      postForm: {\r\n        id: null,\r\n        titulo: '',\r\n        conteudo: ''\r\n      },\r\n      loading: false,\r\n      newPostNotification: false,\r\n      webSocket: null \r\n    };\r\n  },\r\n  created() {\r\n    this.userName = localStorage.getItem('USER_NAME') || 'Usuário';\r\n    this.userId = localStorage.getItem('USER_ID') || null;\r\n    this.fetchPosts();\r\n    this.initializeWebSocket(); \r\n  },\r\n  unmounted() {\r\n    if (this.webSocket) {\r\n      this.webSocket.close();\r\n    }\r\n  },\r\n  methods: {\r\n    initializeWebSocket() {\r\n      // Inicializa a conexão WebSocket\r\n      const protocol = window.location.protocol === 'https:' ? 'wss' : 'ws';\r\n      const wsUrl = `${protocol}://${window.location.host}/ws`;\r\n      this.webSocket = new WebSocket(wsUrl);\r\n\r\n      // Evento para mensagem recebida\r\n      this.webSocket.onmessage = (event) => {\r\n        const message = event.data;\r\n        console.log('Mensagem recebida do WebSocket:', message);\r\n\r\n        // Exibe o snackbar quando uma nova mensagem for recebida\r\n        if (message === 'Novo post publicado!') {\r\n          this.newPostNotification = true;\r\n          this.fetchPosts(); // Atualiza os posts no front-end\r\n        }\r\n      };\r\n\r\n      // Evento de erro\r\n      this.webSocket.onerror = (error) => {\r\n        console.error('Erro no WebSocket:', error);\r\n      };\r\n\r\n      // Evento de fechamento\r\n      this.webSocket.onclose = () => {\r\n        console.warn('WebSocket desconectado. Tentando reconectar em 5 segundos...');\r\n        setTimeout(this.initializeWebSocket, 5000); // Reestabelece a conexão\r\n      };\r\n    },\r\n    async fetchPosts() {\r\n      try {\r\n        const response = await servicesPost.listar('postagem/postagens');\r\n        this.posts = response.data.dados.postagens;\r\n      } catch (error) {\r\n        console.error('Erro ao buscar posts:', error);\r\n      }\r\n    },\r\n    async savePost() {\r\n      try {\r\n        this.loading = true;\r\n        if (this.postForm.id) {\r\n          await servicesPost.editar(`postagem/${this.postForm.id}`, this.postForm);\r\n        } else {\r\n          await servicesPost.adicionar('postagem', this.postForm);\r\n          this.snackbar = true; \r\n        }\r\n        this.postForm = { id: null, titulo: '', conteudo: '' };\r\n        this.fetchPosts();\r\n      } catch (error) {\r\n        console.error('Erro ao salvar post:', error);\r\n      } finally {\r\n        this.loading = false;\r\n      }\r\n    },\r\n    editPost(post) {\r\n      this.postForm = { ...post };\r\n    },\r\n    async deletePost(postId) {\r\n      try {\r\n        await servicesPost.deletar(`postagem/${postId}`);\r\n        this.fetchPosts();\r\n      } catch (error) {\r\n        console.error('Erro ao excluir post:', error);\r\n      }\r\n    },\r\n    logout() {\r\n      localStorage.removeItem('AUTH_TOKEN');\r\n      localStorage.removeItem('USER_NAME');\r\n      localStorage.removeItem('USER_ID');\r\n      this.$router.push(this.$route.query.redirect || '/login');\r\n    },\r\n    formatarData(data) {\r\n      const options = { day: '2-digit', month: '2-digit', year: 'numeric' };\r\n      return new Date(data).toLocaleDateString('pt-BR', options);\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style>\r\n.custom-row-login {\r\n  overflow: auto;\r\n}\r\n\r\n.titulo-login {\r\n  font-size: 29px;\r\n  font-weight: 900;\r\n}\r\n\r\n.card-padding {\r\n  padding: 50px;\r\n}\r\n\r\n.sub-titulo-login {\r\n  font-size: 16px;\r\n  font-weight: 500;\r\n  white-space: wrap;\r\n  color: black !important;\r\n}\r\n\r\n.custom-label-color {\r\n  color: black !important;\r\n  font-weight: 500;\r\n}\r\n\r\n.v-btn--no-padding {\r\n  padding: 0 !important;\r\n}\r\n\r\n.v-btn--text-no-uppercase .v-btn__content {\r\n  text-transform: none !important;\r\n}\r\n\r\n.custom-text-field .v-field__input {\r\n  height: 70px !important; /* Ajuste o valor da altura conforme necessário */\r\n}\r\n\r\n.v-responsive.v-img.custom-v-img {\r\n  margin: 0 auto;\r\n}\r\n\r\n.box-link-criar-conta {\r\n  display: flex;\r\n  justify-conteudo: center;\r\n  margin-top: 36px;\r\n}\r\n\r\n.box-link-criar-conta p {\r\n  font-weight: 400;\r\n  font-size: 20px;\r\n}\r\n\r\n.box-link-criar-conta span {\r\n  color: #F30168;\r\n  text-decoration: underline;\r\n  text-decoration-thickness: 1px;\r\n  cursor: pointer;\r\n}\r\n\r\n@media(max-width: 590px) {\r\n  .titulo-login {\r\n    font-size: 26px;\r\n  }\r\n  \r\n  .sub-titulo-login {\r\n    font-size: 13px;\r\n  }\r\n\r\n  .custom-ma {\r\n    margin: 20px !important;\r\n  }\r\n\r\n  .custom-pa {\r\n    padding: 25px !important;\r\n  }\r\n\r\n  .box-link-criar-conta {\r\n    margin-top: 20px;\r\n  }\r\n\r\n  .custom-v-card-text.v-card-text {\r\n    padding-top: 0px !important;\r\n  }\r\n}\r\n</style>"],"mappings":";AAsFA,SAASA,YAAW,QAAS,8BAA6B;AAE1D,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,MAAM,EAAE,EAAE;MACVC,KAAK,EAAE,KAAK;MACZC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE;QACRC,EAAE,EAAE,IAAI;QACRC,MAAM,EAAE,EAAE;QACVC,QAAQ,EAAE;MACZ,CAAC;MACDC,OAAO,EAAE,KAAK;MACdC,mBAAmB,EAAE,KAAK;MAC1BC,SAAS,EAAE;IACb,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACX,QAAO,GAAIY,YAAY,CAACC,OAAO,CAAC,WAAW,KAAK,SAAS;IAC9D,IAAI,CAACZ,MAAK,GAAIW,YAAY,CAACC,OAAO,CAAC,SAAS,KAAK,IAAI;IACrD,IAAI,CAACC,UAAU,CAAC,CAAC;IACjB,IAAI,CAACC,mBAAmB,CAAC,CAAC;EAC5B,CAAC;EACDC,SAASA,CAAA,EAAG;IACV,IAAI,IAAI,CAACN,SAAS,EAAE;MAClB,IAAI,CAACA,SAAS,CAACO,KAAK,CAAC,CAAC;IACxB;EACF,CAAC;EACDC,OAAO,EAAE;IACPH,mBAAmBA,CAAA,EAAG;MACpB;MACA,MAAMI,QAAO,GAAIC,MAAM,CAACC,QAAQ,CAACF,QAAO,KAAM,QAAO,GAAI,KAAI,GAAI,IAAI;MACrE,MAAMG,KAAI,GAAK,GAAEH,QAAS,MAAKC,MAAM,CAACC,QAAQ,CAACE,IAAK,KAAI;MACxD,IAAI,CAACb,SAAQ,GAAI,IAAIc,SAAS,CAACF,KAAK,CAAC;;MAErC;MACA,IAAI,CAACZ,SAAS,CAACe,SAAQ,GAAKC,KAAK,IAAK;QACpC,MAAMC,OAAM,GAAID,KAAK,CAAC3B,IAAI;QAC1B6B,OAAO,CAACC,GAAG,CAAC,iCAAiC,EAAEF,OAAO,CAAC;;QAEvD;QACA,IAAIA,OAAM,KAAM,sBAAsB,EAAE;UACtC,IAAI,CAAClB,mBAAkB,GAAI,IAAI;UAC/B,IAAI,CAACK,UAAU,CAAC,CAAC,EAAE;QACrB;MACF,CAAC;;MAED;MACA,IAAI,CAACJ,SAAS,CAACoB,OAAM,GAAKC,KAAK,IAAK;QAClCH,OAAO,CAACG,KAAK,CAAC,oBA